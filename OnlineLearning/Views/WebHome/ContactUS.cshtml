@model ContactViewModel
@{
    ViewData["Title"] = "Contact US";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}

<section class="inner-hero">
    <div class="container">
        <div class="inner-hero-content text-center">
            <span class="section-kicker">Contact us</span>
            <h1>Let’s talk about your learning journey</h1>
            <p>
                Send your query and our team will get back to you. Reach out for plans, course access, or support.
            </p>
        </div>
    </div>
</section>

<section class="section-space">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="contact-info-card">
                    <h3>Get in touch</h3>
                    <p>
                        We are here to help with subscriptions, course access, and student support.
                    </p>

                    <div class="contact-info-list">
                        <div class="contact-info-item">
                            <div class="contact-icon"><i class="bi bi-envelope-fill"></i></div>
                            <div>
                                <strong>Email</strong>
                                <span>ManikaLearningAcademy@gmail.com</span>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-icon"><i class="bi bi-telephone-fill"></i></div>
                            <div>
                                <strong>Phone</strong>
                                <span>+91 98765 43210</span>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-icon"><i class="bi bi-geo-alt-fill"></i></div>
                            <div>
                                <strong>Address</strong>
                                <span>Jaipur, Rajasthan, India</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h3>Send a message</h3>
                    <p class="mb-4">Fill in the form and we’ll contact you soon.</p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success rounded-4">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-action="ContactUS" asp-controller="WebHome" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control auth-input" placeholder="Your name" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control auth-input" placeholder="Your email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label"></label>
                            <input asp-for="Subject" class="form-control auth-input" placeholder="Subject" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control auth-input contact-textarea" placeholder="Write your message"></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-plan">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>