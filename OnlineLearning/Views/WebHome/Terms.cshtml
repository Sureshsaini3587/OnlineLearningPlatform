@{
    ViewData["Title"] = "Terms & Conditions";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}

<section class="inner-hero">
    <div class="container">
        <div class="inner-hero-content text-center">
            <span class="section-kicker">Terms of Service</span>
            <h1>Terms & Conditions</h1>
            <p>
                Please read these terms and conditions carefully before using our platform, viewing courses, or accessing practice features.
            </p>
        </div>
    </div>
</section>

<section class="section-space">
    <div class="container">
        <div class="faq-search-box mb-4">
            <i class="bi bi-search"></i>
            <input type="text" id="termsSearchInput" placeholder="Search terms and conditions..." onkeyup="filterTerms()" />
        </div>

        <div class="faq-shell">
            <div class="accordion" id="termsAccordion">

                <!-- Section 1 -->
                <div class="accordion-item faq-item terms-card">
                    <h2 class="accordion-header">
                        <button class="accordion-button faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#terms1">
                            1. Acceptance of Terms
                        </button>
                    </h2>
                    <div id="terms1" class="accordion-collapse collapse show" data-bs-parent="#termsAccordion">
                        <div class="accordion-body">
                            <p>
                                By accessing or using our platform, you agree to be bound by these Terms and Conditions. If you do not agree with any part of these terms, you may not access the services or enroll in any courses.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Section 2 -->
                <div class="accordion-item faq-item terms-card">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#terms2">
                            2. Account Registration & Security
                        </button>
                    </h2>
                    <div id="terms2" class="accordion-collapse collapse" data-bs-parent="#termsAccordion">
                        <div class="accordion-body">
                            <p>To access full course videos and practice modules (PQJ), you must register an account. You agree to:</p>
                            <ul>
                                <li>Provide accurate and complete registration information.</li>
                                <li>Maintain the confidentiality of your login credentials.</li>
                                <li>Notify us immediately of any unauthorized use of your account.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Section 3 -->
                <div class="accordion-item faq-item terms-card">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#terms3">
                            3. Subscriptions & Payments
                        </button>
                    </h2>
                    <div id="terms3" class="accordion-collapse collapse" data-bs-parent="#termsAccordion">
                        <div class="accordion-body">
                            <p>
                                Demo videos are accessible free of charge. Access to full course content requires an active paid subscription plan.
                            </p>
                            <ul>
                                <li><strong>Renewal:</strong> Subscriptions must be manually renewed or upgraded based on available plans.</li>
                                <li><strong>Refunds:</strong> All subscription purchases are non-refundable unless specified otherwise in writing.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Section 4 -->
                <div class="accordion-item faq-item terms-card">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#terms4">
                            4. Intellectual Property & Usage Restrictions
                        </button>
                    </h2>
                    <div id="terms4" class="accordion-collapse collapse" data-bs-parent="#termsAccordion">
                        <div class="accordion-body">
                            <p>
                                All course videos, study materials, and PQJ practice questions are our exclusive intellectual property.
                            </p>
                            <ul>
                                <li>You are granted a personal, non-exclusive, and non-transferable license to view content.</li>
                                <li>You may <strong>not</strong> record, download, re-distribute, or share account access with third parties.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Section 5 -->
                <div class="accordion-item faq-item terms-card">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#terms5">
                            5. Modifications & Support
                        </button>
                    </h2>
                    <div id="terms5" class="accordion-collapse collapse" data-bs-parent="#termsAccordion">
                        <div class="accordion-body">
                            <p>
                                We reserve the right to modify or update these terms at any time. Continued use of the platform after updates constitutes acceptance of the new terms.
                            </p>
                            <p class="mb-0">
                                For questions regarding these terms, contact support at <a href="mailto:Manika.learning.academy@gmail.com">Manika.learning.academy@gmail.com</a>.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
 
    <script>
        function filterTerms() {
            let input = document.getElementById('termsSearchInput').value.toLowerCase();
            let items = document.querySelectorAll('.terms-card');

            items.forEach(function (item) {
                let text = item.innerText.toLowerCase();
                if (text.includes(input)) {
                    item.style.display = "";
                } else {
                    item.style.display = "none";
                }
            });
        }
    </script>
 