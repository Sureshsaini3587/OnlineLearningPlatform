@{
    ViewData["Title"] = "Subscription Plans";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}

<section class="inner-hero">
    <div class="container">
        <div class="inner-hero-content text-center">
            <span class="section-kicker">Pricing plans</span>
            <h1>Simple subscriptions for premium learning access</h1>
            <p>
                Start with free demo content and move to a plan when you are ready to unlock full lessons and PQJ practice.
            </p>
        </div>
    </div>
</section>

<section class="section-space pricing-section">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="pricing-card">
                    <span class="plan-label">Starter</span>
                    <h3>Monthly</h3>
                    <div class="price">₹299</div>
                    <ul class="plan-list">
                        <li><i class="bi bi-check2"></i> Full course access</li>
                        <li><i class="bi bi-check2"></i> Demo videos</li>
                        <li><i class="bi bi-check2"></i> PQJ practice</li>
                        <li><i class="bi bi-check2"></i> Dashboard tracking</li>
                    </ul>
                    <a href="#" class="btn btn-plan w-100">Choose Monthly</a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="pricing-card featured">
                    <div class="featured-ribbon">Most Popular</div>
                    <span class="plan-label">Pro Value</span>
                    <h3>Quarterly</h3>
                    <div class="price">₹799</div>
                    <ul class="plan-list">
                        <li><i class="bi bi-check2"></i> Better savings</li>
                        <li><i class="bi bi-check2"></i> Complete video library</li>
                        <li><i class="bi bi-check2"></i> Unlimited PQJ access</li>
                        <li><i class="bi bi-check2"></i> Priority content</li>
                    </ul>
                    <a href="#" class="btn btn-plan w-100">Choose Quarterly</a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="pricing-card">
                    <span class="plan-label">Ultimate</span>
                    <h3>Yearly</h3>
                    <div class="price">₹1999</div>
                    <ul class="plan-list">
                        <li><i class="bi bi-check2"></i> Best value plan</li>
                        <li><i class="bi bi-check2"></i> Premium lessons access</li>
                        <li><i class="bi bi-check2"></i> Full PQJ question bank</li>
                        <li><i class="bi bi-check2"></i> Extended learning support</li>
                    </ul>
                    <a href="#" class="btn btn-plan w-100">Choose Yearly</a>
                </div>
            </div>
        </div>

        <div class="plans-note-card mt-5">
            <h4>What happens after subscription?</h4>
            <p>
                Once subscribed, students can access locked full-course videos, track lesson progress,
                and use the PQJ module for practice and revision.
            </p>
        </div>
    </div>
</section>