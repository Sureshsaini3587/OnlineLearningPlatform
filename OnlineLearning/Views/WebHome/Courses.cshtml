
@model HomeVM
@{
    ViewData["Title"] = "Courses";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
} 

<section class="inner-hero">
    <div class="container">
        <div class="inner-hero-content text-center">
            <span class="section-kicker">Explore courses</span>
            <h1>Discover premium learning tracks</h1>
            <p>
                Browse structured courses, preview demo classes, and unlock complete video content with subscription.
            </p>
        </div>
    </div>
</section>

<section class="section-space">
    <div class="container"> 
            <div class="course-filter-bar"> 
                <div class="filter-search">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" placeholder="Search courses..."  />
                </div>

                <select name="categoryId" class="form-select filter-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories
                                    .GroupBy(c => c.CategoryId)
                                    .Select(g => g.First()))
                    {
                        <option value="@cat.CategoryId"
                                selected="@(Context.Request.Query["categoryId"] == cat.CategoryId.ToString())">
                            @cat.CategoryName
                        </option>
                    }
                </select>  
            </div> 
        <div id="courseContainer">
            @await Html.PartialAsync("_CourseList", Model.Courses)
        </div> 
    </div>
</section>
<script>
    const searchInput = document.querySelector('input[name="search"]');
    const categorySelect = document.querySelector('select[name="categoryId"]');

    let timeout = null;

    function loadCourses() {
        const search = searchInput.value;
        const categoryId = categorySelect.value;

        fetch(`/WebHome/Courses?search=${search}&categoryId=${categoryId}&isAjax=true`)
        .then(res => res.text())
        .then(data => {
            document.getElementById("courseContainer").innerHTML = data;
        });
    }
     
    searchInput.addEventListener("keyup", () => {
        clearTimeout(timeout);
        timeout = setTimeout(loadCourses, 400);
    });

    categorySelect.addEventListener("change", loadCourses);
</script>