@{
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
    ViewData["Title"] = "PQJ Practice";
} 

<section class="inner-hero">
    <div class="container">
        <div class="inner-hero-content text-center">
            <span class="section-kicker">PQJ Practice</span>
            <h1>Practice Smarter with PQJs</h1>
            <p>
                Boost your exam preparation with real exam-level questions, instant solutions, and performance tracking.
            </p>
            <a asp-controller="Account"
                   asp-action="Login" 
                   class="btn btn-course-view">
                Start Practicing
            </a> 
        </div>
    </div>
</section> 
 
<section class="section-space">
    <div class="container">
        <div class="row g-4 mt-1">
            <div class="col-md-6 col-lg-4" data-aos="zoom-in">
                <div class="feature-box">
                    <div class="feature-icon icon-a"> <i class="bi bi-lightning-charge"></i></div>
                    <h5>Instant Practice</h5>
                    <p>Solve questions topic-wise anytime.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4" data-aos="zoom-in" data-aos-delay="80">
                <div class="feature-box">
                    <div class="feature-icon icon-b"><i class="bi bi-clock-history"></i></div>
                    <h5>Real Exam Timer</h5>
                    <p>Practice under time pressure like real exams.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4" data-aos="zoom-in" data-aos-delay="140">
                <div class="feature-box">
                    <div class="feature-icon icon-c"><i class="bi bi-bar-chart"></i></div>
                    <h5>Performance Analytics</h5>
                    <p>Track your accuracy and weak areas.</p>
                </div>
            </div>
         </div> 
    </div>
</section>

<!-- CATEGORY SECTION -->
<section class="section-space bg-light">
    <div class="container">
        <h2 class="text-center mb-4">Practice by Category</h2>

        <div class="row g-4">

            <div class="col-md-3">
                <div class="category-card">
                    <h5>Reasoning</h5>
                    <a href="/PQJ/Category/1" class="btn btn-outline-primary btn-sm">Start</a>
                </div>
            </div>

            <div class="col-md-3">
                <div class="category-card">
                    <h5>Maths</h5>
                    <a href="/PQJ/Category/2" class="btn btn-outline-primary btn-sm">Start</a>
                </div>
            </div>

            <div class="col-md-3">
                <div class="category-card">
                    <h5>English</h5>
                    <a href="/PQJ/Category/3" class="btn btn-outline-primary btn-sm">Start</a>
                </div>
            </div>

            <div class="col-md-3">
                <div class="category-card">
                    <h5>General Knowledge</h5>
                    <a href="/PQJ/Category/4" class="btn btn-outline-primary btn-sm">Start</a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- CTA -->
<section class="pqj-cta text-center">
    <div class="container">
        <h2>Ready to test your knowledge?</h2>
        <a href="/Account/Register" class="btn btn-success btn-lg">Join & Start Practice</a>
    </div>
</section>