@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}

<section class="inner-hero">
    <div class="container">
        <div class="inner-hero-content">
            <span class="section-kicker">About us</span>
            <h1>We simplify complex concepts into easy-to-grasp steps to ensure long-term retention and better understanding.</h1>
            <p>
                Manika Learning Academy  is built to give students a modern learning experience with free demo classes,
                subscription-based premium courses, and PQJ practice for stronger understanding.
            </p>
        </div>
    </div>
</section>

<section class="section-space">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="about-media-card">
                    <img src="https://picsum.photos/800/520?random=401" alt="About Manika Learning Academy" class="img-fluid rounded-4" />
                </div>
            </div>

            <div class="col-lg-6">
                <div class="about-content-block">
                    <span class="section-kicker">Our mission</span>
                    <h2>Learning should be visually engaging and easy to follow</h2>
                    <p>
                        Manika Learning Academy  is built to help  students upgrade their learning and achieve success in competitive exams through clear concepts
                        , smart strategies, and expert guidance.

                        We focus on structured courses, smooth student flow, and better retention through
                        clear content presentation and guided question practice.
                    </p>

                    <div class="about-points">
                        <div class="about-point">
                            <i class="bi bi-check2-circle"></i>
                            <span>Free demo lessons before subscription</span>
                        </div>
                        <div class="about-point">
                            <i class="bi bi-check2-circle"></i>
                            <span>Premium full-course learning experience</span>
                        </div>
                        <div class="about-point">
                            <i class="bi bi-check2-circle"></i>
                            <span>PQJ practice with explanation flow</span>
                        </div>
                        <div class="about-point">
                            <i class="bi bi-check2-circle"></i>
                            <span>Student-first dashboard and progress tracking</span>
                        </div>
                    </div>

                    <a href="/Courses" class="btn btn-plan mt-4">Explore Courses</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-space feature-section">
    <div class="container">
        <div class="section-head text-center">
            <span class="section-kicker">Why Manika Learning Academy</span>
            <h2>Focused on clarity, quality, and growth</h2>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon icon-a"><i class="bi bi-easel-fill"></i></div>
                    <h5>Structured Lessons</h5>
                    <p>Clear topic-based lesson arrangement with better visual presentation.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon icon-b"><i class="bi bi-play-circle-fill"></i></div>
                    <h5>Preview Before You Buy</h5>
                    <p>Demo access helps students understand the content quality first.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon icon-c"><i class="bi bi-ui-checks-grid"></i></div>
                    <h5>Practice That Reinforces</h5>
                    <p>PQJ modules make revision and performance improvement easier.</p>
                </div>
            </div>
        </div>
    </div>
</section>