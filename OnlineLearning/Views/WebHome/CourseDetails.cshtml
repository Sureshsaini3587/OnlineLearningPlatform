@{
    ViewData["Title"] = "Course Details";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}
@model CourseDetailsVM
<section class="inner-hero inner-hero-sm">
    <div class="container">
        <div class="inner-hero-content">
            <span class="section-kicker">Course details</span>
            <h1>Master Web UI for Modern Platforms</h1>
            <p>
                A structured premium course with free demo access, locked advanced modules, and integrated PQJ practice.
            </p>
        </div>
    </div>
</section>

<section class="section-space">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <div class="details-main-card"> 
                    <div class="details-video-preview"
                         style="background-image:url('@(Model.Thumbnail ?? "/default.jpg")')"> 
                        @if (Model.HasDemo)
                        {
                            <span class="preview-pill">Preview Available</span>
                        }
                    </div>
                    <div class="details-info-grid">
                        <div class="details-info-chip"><i class="bi bi-star-fill"></i> 4.8 Rating</div> 
                        <div class="details-info-chip"> <i class="bi bi-camera-video"></i> @Model.TotalLectures Lessons   </div> 
                        <div class="details-info-chip">   <i class="bi bi-bar-chart"></i> @Model.LevelName </div> 
                        <div class="details-info-chip">   <i class="bx bx-category"></i> @Model.CategoryName   </div> 
                        <div class="details-info-chip"><i class="bi bi-patch-check-fill"></i> Certificate</div>
                    </div>

                    <div class="details-section-block">
                        <h3>What you will learn</h3>
                        <div class="learn-grid">
                            <div><i class="bi bi-check2-circle"></i> Modern UI layout strategy</div>
                            <div><i class="bi bi-check2-circle"></i> Razor-based page design</div>
                            <div><i class="bi bi-check2-circle"></i> Premium animation styling</div>
                            <div><i class="bi bi-check2-circle"></i> Dashboard and course flows</div>
                        </div>
                    </div>

                    <div class="details-section-block">
                        <h3>Course content</h3>
                        <div class="lesson-list-card"> 
                            @foreach (var section in Model.Sections)
                            {
                                foreach (var video in section.Videos)
                                {
                                    <div class="lesson-row-item @(video.IsDemo ? "free" : "locked")">
            
                                        <div class="lesson-left">

                                            @if (video.IsDemo)
                                            {
                                                <span class="lesson-badge free-badge">Free Demo</span>
                                            }
                                            else
                                            {
                                                <span class="lesson-badge lock-badge">Locked</span>
                                            }

                                            <div>
                                                <h6>@video.Title</h6>
                                                <p>
                                                    @(video.IsDemo ? "Watchable for all" : "Requires subscription")
                                                </p>
                                            </div>
                                        </div>

                                        @if (video.IsDemo)
                                        {
                                            <button class="btn btn-lesson-action"
                                                    onclick="playVideo('@video.VideoUrl', @video.IsDemo.ToString().ToLower())">
                                                Play
                                            </button> 
                                        }
                                        else
                                        {

                                            <button class="btn btn-lesson-locked" onclick="showSubscribe()">
                                                <i class="bi bi-lock-fill"></i>
                                            </button> 
                                        }

                                    </div>
                                }
                            } 
                        </div> 
                    </div>

                    <div class="details-section-block">
                        <h3>PQJ Practice included</h3>
                        <div class="pqj-inline-box">
                            <div>
                                <h5>Test your understanding after each module</h5>
                                <p>
                                    Solve topic-wise questions, track score, and revisit explanations instantly.
                                </p>
                            </div>
                            <a href="/PQJ" class="btn btn-course-view">Open PQJ</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="details-side-card">
                    <div class="side-price-block"> 
                        <h2>₹@Model.Price</h2>
                        <h4>@Model.CourseTitle</h4>
                        <span>Included in subscription</span>
                    </div>

                    <ul class="plan-list mb-4">
                        <li><i class="bi bi-check2"></i> Demo video access</li>
                        <li><i class="bi bi-check2"></i> Full lesson library</li>
                        <li><i class="bi bi-check2"></i> PQJ practice sets</li>
                        <li><i class="bi bi-check2"></i> Progress tracking</li>
                    </ul>
                    <a href="/WebHome/CoursePlans?courseId=@Model.CourseId"  class="btn btn-plan w-100 mb-3">                   
                       🔓 Unlock Full Course                   
                   </a>  
                    @* <a href="/Demo" class="btn btn-outline-dark w-100 rounded-pill py-3">Watch Demo First</a> *@
                </div>
            </div>
        </div>
    </div> 
</section>
<div class="modal fade" id="videoModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content"> 
            <div class="modal-body p-0">
                <iframe id="videoFrame"
                        width="100%" height="400"
                        src=""
                        frameborder="0"
                        allowfullscreen>
                </iframe>
            </div> 
        </div>
    </div>
</div> 
<script > 
     
     function startPayment(planId, courseId) {
         showLoader();
         fetch('/Payment/Start', {
             method: 'POST',
             headers: {
                 'Content-Type': 'application/json'
             },
             body: JSON.stringify({
                 planId: parseInt(planId),
                 courseId: parseInt(courseId)
             })
         })
             .then(res => res.json())
             .then(data => {
                 showPaymentUI(data);
             })
             .catch(() => {

                 document.getElementById("planModalBody").innerHTML =
                     `<div class="alert alert-danger">
             Payment initialization failed
          </div>`;
             });
     }
     function showPaymentUI(data) {
         document.getElementById("planModalBody").innerHTML = `
         <div class="payment-box text-center">
             <h3 class="mb-3">Complete Payment</h3>
             <div class="payment-price">
                 ₹${data.amount}
             </div>
             <p class="text-muted mb-4">
                 Secure payment gateway
             </p>
             <button class="btn btn-success px-5 py-3 rounded-pill"
                     onclick="completePayment(${data.planId}, ${data.courseId})">
                 🔒 Pay Securely
             </button>
         </div>
     `;
     } function completePayment(planId, courseId) {
         showLoader();
         fetch('/Payment/Success', {
             method: 'POST',
             headers: {
                 'Content-Type': 'application/json'
             },
             body: JSON.stringify({
                 planId: planId,
                 courseId: courseId
             })
         })
             .then(res => res.json())
             .then(data => {
                 document.getElementById("planModalBody").innerHTML = `
        <div class="text-center p-5">
            <div class="success-check mb-3">
                ✅
            </div>
            <h3>Payment Successful</h3>
            <p class="text-muted">
                Your course is now unlocked
            </p>
            <button class="btn btn-primary px-5 py-3 rounded-pill"
                    onclick="location.reload()">
                Start Learning 🚀
            </button>
        </div>
    `;
             });
     }
     function getEmbedUrl(url) {
         let videoId = "";

         if (url.includes("watch?v=")) {
             videoId = url.split("watch?v=")[1].split("&")[0];
         }
         else if (url.includes("youtu.be/")) {
             videoId = url.split("youtu.be/")[1].split("?")[0];
         }
         else if (url.includes("shorts/")) {
             videoId = url.split("shorts/")[1].split("?")[0];
         }

         return "https://www.youtube.com/embed/" + videoId;
     }
     function playVideo(url, isDemo) {
        
         let embedUrl = getEmbedUrl(url);
         document.getElementById("videoFrame").src = embedUrl;

         var modal = new bootstrap.Modal(document.getElementById('videoModal'));
         modal.show();
     }
     document.getElementById('videoModal').addEventListener('hidden.bs.modal', function () {
         document.getElementById("videoFrame").src = "";
     });
</script>
  