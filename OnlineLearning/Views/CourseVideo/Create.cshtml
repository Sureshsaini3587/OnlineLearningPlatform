@model CourseVideo 
 
@if (ViewBag.Success != null)
{
    <div class="alert alert-success mt-3">
        @ViewBag.Success
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mt-3">
        @ViewBag.Error
    </div>
}
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-block">
                <div class="d-flex justify-content-end  mb-3">
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="history.back()">
                        ← Back
                    </button>
                </div>
                <h4 class="sub-title">Video Details</h4>
                <form asp-action="Create" method="post"> 
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label"> Title *</label>
                        <div class="col-sm-10">
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Sort Order *</label>
                        <div class="col-sm-10">
                            <input asp-for="SortOrder" class="form-control" type="text" />
                            <span asp-validation-for="SortOrder" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Video Url *</label>
                        <div class="col-sm-10">
                            <input asp-for="VideoUrl" class="form-control" type="text"  />
                            <span asp-validation-for="VideoUrl" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Duration *</label>
                        <div class="col-sm-10">
                            <input asp-for="Duration" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Duration" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Section *</label>
                        <div class="col-sm-10">
                            <select asp-for="SectionId" asp-items="ViewBag.Section" class="form-control">
                                <option value="">-- Select Section --</option>
                            </select>
                            <span asp-validation-for="SectionId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-3">
                        <div class="col-sm-10 offset-sm-2">
                            <div class="form-check">
                                <input asp-for="IsDemo" class="form-check-input" />
                                <label class="form-check-label">Is Demo</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" checked />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mt-4 d-flex justify-content-end">
                        <div class="col-sm-1">
                            <button type="submit" class="btn btn-success">Save</button>
                        </div>
                        <div class="col-sm-1">
                            <button type="reset" class="btn btn-secondary">Reset</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
 