@model CourseVideo
   
 
<form asp-action="@(Model.VideoId == 0 ? "Create" : "Edit")"
      method="post" id="VideoForm" class="needs-validation">
      
    @Html.AntiForgeryToken()

    @if (Model.VideoId != 0)
    {
        <input type="hidden" asp-for="VideoId" />
    }

    <div class="modal-body p-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted small">Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control"   placeholder="Enter video title..." required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
            </div>           
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted small">Sort Order <span class="text-danger">*</span></label>
                <input asp-for="SortOrder" class="form-control"  required />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
        </div> 
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted small">Duration</label>
                <input asp-for="Duration" class="form-control"   required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
            </div>           
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted small">Section<span class="text-danger">*</span></label>
                <select asp-for="SectionId" asp-items="ViewBag.Section" class="form-control">
                    <option value="">-- Select Section --</option>
                </select>
                <span asp-validation-for="SectionId" class="text-danger"></span>
            </div>
        </div>  
        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label fw-bold text-muted small">Video Url<span class="text-danger">*</span></label>
                <input asp-for="VideoUrl" class="form-control" required />
                <span asp-validation-for="VideoUrl" class="text-danger small"></span>
            </div>  
        </div>  
        <div class="mt-4 p-3 border rounded bg-light">
            <div class="form-check form-switch d-flex justify-content-between align-items-center mb-2">
                <label class="form-check-label fw-bold" for="pubSwitch">Is Demo</label>
                <input asp-for="IsDemo" class="form-check-input" type="checkbox" id="pubSwitch">
                </div>
                <hr />
                <div class="form-check form-switch d-flex justify-content-between align-items-center">
                    <label class="form-check-label fw-bold" for="actSwitch">Active</label>
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="actSwitch">
                </div>
         </div>
            
    </div>  
        <div class="modal-footer border-0 p-3 bg-white rounded-bottom">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-success px-4 shadow-sm">
            <i class="bi bi-save me-1"></i> @(Model.VideoId == 0 || Model.VideoId == null ? "Save" : "Update Changes")
            </button>
        </div>
    </form> 