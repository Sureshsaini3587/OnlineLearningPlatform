@model PlanCourseVM
  
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-block">
                <h4 class="sub-title">Assign Courses to Plan</h4>
                <form asp-action="Edit" method="post"> 
                    <div class="form-group mb-3">
                        <label class="fw-bold">Plan</label>
                        <select asp-for="PlanId"
                                class="form-control"
                                asp-items="Model.Plans"
                                disabled>
                        </select> 
                        <input type="hidden" asp-for="PlanId" />
                    </div> 
                    <div class="mb-2">
                        <input type="checkbox" id="selectAll" />
                        <label for="selectAll" class="fw-bold">Select All Courses</label>
                    </div> 
                    <div class="row">
                        @foreach (var course in Model.Courses)
                        {
                            var isChecked = Model.SelectedCourseIds.Contains(int.Parse(course.Value));

                            <div class="col-md-4 mb-2">
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="SelectedCourseIds"
                                           value="@course.Value"
                                           class="form-check-input course-checkbox"
                                    @(isChecked ? "checked" : "") />

                                    <label class="form-check-label">
                                        @course.Text
                                    </label>
                                </div>
                            </div>
                        }
                    </div> 
                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-warning">Update</button>
                        <button type="reset" class="btn btn-secondary">Reset</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<script>
    $("#selectAll").click(function () {
        $("input[name='SelectedCourseIds']").prop('checked', this.checked);
    });
</script>