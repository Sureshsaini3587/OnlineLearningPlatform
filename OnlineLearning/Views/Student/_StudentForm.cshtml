@model Student

<form asp-action="@(Model.StudentId == null ||Model.StudentId == 0 ? "Create" : "Edit")"
      method="post"
      enctype="multipart/form-data"
      id="studentForm">

    @Html.AntiForgeryToken()

    @if (Model.StudentId != 0 || Model.StudentId != null)
    {
        <input type="hidden" asp-for="StudentId" />
    }

    <div class="modal-body">
        <div class="row g-3"> 
            <div class="col-md-7">
                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name *</label>
                    <input asp-for="FullName" class="form-control" required placeholder="Enter student name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Email *</label>
                        <input asp-for="Email" class="form-control" type="email" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Mobile *</label>
                        <input asp-for="Mobile" class="form-control" oninput="this.value=this.value.replace(/[^0-9]/g,'')" maxlength="10" />
                        <span asp-validation-for="Mobile" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Gender *</label>
                        <select asp-for="Gender" asp-items="ViewBag.Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Date of Birth *</label>
                        <input asp-for="DOB" class="form-control" type="date" />
                        <span asp-validation-for="DOB" class="text-danger small"></span>
                    </div>
                </div>
            </div>
             
            <div class="col-md-5 text-center">
                <label class="form-label fw-bold">Profile Image</label>
                <div class="border p-2 mb-2 rounded shadow-sm bg-light">
                    <img id="previewimage"
                         src="@(Model.ProfileImage != null ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.ProfileImage)}" : "/images/default-avatar.png")"
                         class="img-fluid rounded"
                         style="height:150px; width:100%; object-fit:cover;" />
                </div>
                <input type="file" name="ImageFile" accept="image/*" class="form-control form-control-sm" onchange="previewFile(event)" />
                
                <div class="mt-4 text-start">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" id="activeSwitch" />
                        <label class="form-check-label" for="activeSwitch">Set as Active</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Address</label>
            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="modal-footer border-0">
        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary rounded-pill px-4">
            @(Model.StudentId == null || Model.StudentId == 0 ? "Save Student" : "Update Changes") 
        </button>
    </div>
</form>