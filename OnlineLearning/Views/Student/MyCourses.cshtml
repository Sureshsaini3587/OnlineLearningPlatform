@{
    Layout = "~/Views/Shared/Web/_StudentLayout.cshtml";
    ViewData["Title"] = "My Course";
}
@model List<CourseDTO> 
@using OnlineLearning.Views.Services
@inject ProtectorService protector
 
<div class="row g-4">
    <div class="col-xl-12">  
        <div class="student-panel-card mt-4">
            <div class="panel-head">
                <h4>My Courses</h4> 
                <p>
                    Continue your enrolled learning programs.
                </p>
            </div>
            <section class="section-space">
                <div class="container">

                    @if (Model.Any())
                    {  
                            @foreach (var course in Model)
                            {
                                <div class="col-md-6 col-lg-4">

                                    <div class="course-show-card">

                                        <div class="course-thumb">
                                             <img src="~/Uploads/courses/@course.Thumbnail"  />  
                                        <span class="course-chip @(course.IsActive ? "premium" : "bg-danger")">
                                            @(course.IsActive ? "Active" : "Inactive")
                                        </span>

                                        </div>

                                        <div class="course-body">

                                            <h5>
                                                @course.CourseTitle
                                            </h5>

                                            <p>
                                                @course.Description
                                            </p>

                                            <div class="course-meta">

                                                <span>
                                                    <i class="bi bi-bar-chart"></i>
                                                    @course.LevelName
                                                </span>

                                                <span>
                                                    <i class="bx bx-category"></i>
                                                    @course.CategoryName
                                                </span>

                                            </div>

                                            <div class="mt-4">

                                                <a href="/Student/CourseDetails/@protector.Encrypt(course.CourseId)"
                                                       class="btn btn-plan w-100">

                                                    Continue Learning 🚀

                                                </a>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            } 
                    }
                    else
                    {
                        <div class="empty-course-box text-center">

                            <h3>
                                No Active Courses
                            </h3>

                            <p class="text-muted">
                                You have not enrolled in any course yet.
                            </p>

                            <a href="/WebHome/Courses"
                                   class="btn btn-plan px-5 mt-3">

                                Browse Courses

                            </a>

                        </div>
                    }

                </div>
            </section>
        </div>
    </div> 
</div>