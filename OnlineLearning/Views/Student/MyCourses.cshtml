@{
    Layout = "~/Views/Shared/Web/_StudentLayout.cshtml";
    ViewData["Title"] = "My Course";
}

<div class="row g-4">
    <div class="col-xl-12">  
        <div class="student-panel-card mt-4">
            <div class="panel-head">
                <h4>My Courses</h4>
                <a href="/WebHome/Courses">Browse more</a>
            </div> 
            <div class="row g-4">
                @for (int i = 1; i <= 2; i++)
                {
                    <div class="col-md-6">
                        <div class="mini-course-card">
                            <img src="https://picsum.photos/400/260?random=@(30 + i)" />
                            <div class="mini-course-body">
                                <h5>Premium Course @i</h5>
                                <p>Watch lessons and improve with PQJ practice.</p>
                                <a href="/Courses/Details/@i">Open Course</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div> 
</div>