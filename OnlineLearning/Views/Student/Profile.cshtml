@model StudentProfileViewModel

@{
    ViewData["Title"] = "Student Profile";
}

<div class="container py-1"> 
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-person-circle me-2" style="color: #1c2541;"></i> Account Profile</h2>
            <p class="text-muted small mb-0">Manage your personal information and profile settings.</p>
        </div>
        <span class="badge text-white px-3 py-2 rounded-pill fw-semibold shadow-sm" style="background-color: #1c2541;">
            <i class="bi bi-shield-check me-1 text-warning"></i> Student Account
        </span>
    </div>

    <form asp-action="Profile" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="StudentId" />

        <div class="row g-4"> 
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white position-relative overflow-hidden h-100">
                  
                    <div class="position-absolute top-0 start-0 w-100" style="height: 110px; background-color: #1c2541;"></div>

                    <div class="position-relative mt-4 mb-3">
                        <div class="d-inline-block position-relative avatar-container">
                            @if (Model.ProfileImage != null && Model.ProfileImage.Length > 0)
                            {
                                <img id="previewimage" src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ProfileImage)" 
                                     class="rounded-circle shadow border border-3 border-white" width="130" height="130" style="object-fit: cover; object-position: center;" />
                            }
                            else
                            {
                                <img id="previewimage" src="https://via.placeholder.com/130?text=No+Image" 
                                     class="rounded-circle shadow border border-3 border-white" width="130" height="130" style="object-fit: cover; object-position: center;" />
                            }
                             
                            <label for="ImageFile" class="position-absolute bottom-0 end-0 text-white rounded-circle p-2 shadow-sm cursor-pointer d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background-color: #1c2541; border: 2px solid #fff;" title="Change Photo">
                                <i class="bi bi-camera-fill small text-warning"></i>
                            </label>
                        </div>
                    </div>
                     
                    <input type="file" asp-for="ImageFile" id="ImageFile" accept="image/*" class="d-none" onchange="previewFile(event)" />

                    <h4 class="fw-bold text-dark mb-1 mt-2">@(string.IsNullOrEmpty(Model.FullName) ? "Student User" : Model.FullName)</h4>
                    <p class="text-muted small mb-3">@Model.Email</p>

                    <div class="d-grid gap-2 mt-auto pt-3 border-top">
                        <label for="ImageFile" class="btn btn-outline-dark btn-sm rounded-pill py-2 fw-semibold cursor-pointer mb-0">
                            <i class="bi bi-cloud-arrow-up me-1"></i> Upload New Photo
                        </label>
                        <span class="text-muted" style="font-size: 0.75rem;">Allowed JPG, PNG. Max size 2MB</span>
                    </div>
                </div>
            </div>
             
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-sliders me-2" style="color: #1c2541;"></i> Personal Information</h5>
                        <span class="text-muted small">All fields marked are secure</span>
                    </div>
                    
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small mb-4"></div>

                    <div class="row g-3"> 
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0 ps-0 bg-light bg-opacity-50" placeholder="Enter full name" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                        </div> 
                        <div class="col-md-6">
                            <label asp-for="Mobile" class="form-label fw-semibold text-secondary small">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-phone"></i></span>
                                <input asp-for="Mobile" type="tel" oninput="this.value=this.value.replace(/[^0-9]/g,'')" pattern="[0-9]{10}" inputmode="numeric" maxlength="10" class="form-control border-start-0 ps-0 bg-light bg-opacity-50" placeholder="10-digit mobile number" />
                            </div>
                            <span asp-validation-for="Mobile" class="text-danger small mt-1 d-block"></span>
                        </div>
                         
                        <div class="col-md-6">
                            <label asp-for="DOB" class="form-label fw-semibold text-secondary small">Date of Birth</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="DOB" type="date" class="form-control border-start-0 ps-0 bg-light bg-opacity-50" />
                            </div>
                            <span asp-validation-for="DOB" class="text-danger small mt-1 d-block"></span>
                        </div>
                         
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold text-secondary small">Gender</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-gender-ambiguous"></i></span>
                                <select asp-for="Gender" class="form-select border-start-0 ps-0 bg-light bg-opacity-50">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                         
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold text-secondary small">Residential Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted align-items-start pt-2"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="Address" class="form-control border-start-0 ps-0 bg-light bg-opacity-50" rows="3" placeholder="Enter your full address"></textarea>
                            </div>
                            <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                     
                    <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-3 border-top">
                        <button type="submit" class="btn text-white px-5 py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2" style="background-color: #1c2541;">
                            <i class="bi bi-check2-circle text-warning"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .cursor-pointer {
        cursor: pointer;
    }
    .form-control:focus, .form-select:focus {
        background-color: #fff !important;
        box-shadow: none;
        border-color: #1c2541;
    }
    .avatar-container img {
        transition: transform 0.2s ease-in-out;
    }
    .avatar-container:hover img {
        transform: scale(1.02);
    }
</style>

<script>
    function previewFile(event) {
        var reader = new FileReader();
        reader.onload = function () {
            var output = document.getElementById('previewimage');
            output.src = reader.result;
        }
        if(event.target.files && event.target.files[0]) {
            reader.readAsDataURL(event.target.files[0]);
        }
    }
</script>