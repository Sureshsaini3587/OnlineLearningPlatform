@{
    Layout = "~/Views/Shared/Web/_StudentLayout.cshtml";
    ViewData["Title"] = "PQJ Practice";
}

@model PQJPlayerVM
<div class="pqj-page-wrap">
    <div class="pqj-top-card">
        <div>
            <span class="section-kicker">Practice module</span>
            <h1>PQJ Smart Practice</h1>
            <p>Choose topic, difficulty, and start testing your knowledge instantly.</p>
        </div>
        <button class="btn btn-plan">Start Practice</button>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-4">
            <div class="student-panel-card">
                <div class="panel-head">
                    <h4>Set Preferences</h4>
                </div>

                <div class="mb-3">
                    <label class="form-label">Course</label>
                    <select id="courseId" name="courseId" class="form-select auth-input">
                        <option value="">Select Course</option>
                        @foreach (var c in Model.Courses)
                        {
                            <option value="@c.CourseId">@c.CourseTitle</option>
                        }
                    </select> 
                </div>

                <div class="mb-3">
                    <label class="form-label">Topic</label>
                    <select id="topicId" name="topicId" class="form-select auth-input">
                        <option value="">Select Topic</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label">Difficulty</label>
                    <select class="form-select auth-input" name="difficulty">
                        <option value="1">Easy</option>
                        <option value="2">Medium</option>
                        <option value="3">Hard</option>
                    </select>
                </div>
                <button class="btn btn-plan w-100" onclick="loadQuestion(1)">Generate Questions</button> 
            </div>
        </div> 
        <div class="col-lg-8">
            <div id="pqjPlayerContainer">
                @await Html.PartialAsync("_PQJPlayer", Model)
            </div>
        </div> 
    </div>
</div>
<script>
    document.getElementById("courseId").addEventListener("change", function () { 
        let courseId = this.value; 
        let topicDropdown = document.getElementById("topicId");
        topicDropdown.innerHTML = `<option value="">Loading...</option>`;

        if (!courseId) {
            topicDropdown.innerHTML = `<option value="">Select Topic</option>`;
            return;
        }

        fetch(`/WebHome/GetTopicsByCourse?courseId=${courseId}`)
            .then(res => res.json())
            .then(data => {
                topicDropdown.innerHTML = `<option value="">Select Topic</option>`;
                data.forEach(t => {
                    topicDropdown.innerHTML += `<option value="${t.sectionId}">${t.sectionTitle}</option>`;
                });
            })
            .catch(() => {
                topicDropdown.innerHTML = `<option>Error loading topics</option>`;
            });
    });
    function loadQuestion(index) {
        let courseId = document.getElementById("courseId")?.value;
        let topicId = document.getElementById("topicId")?.value;
        let difficulty = document.querySelector("[name='difficulty']")?.value;

        fetch(`/Student/LoadQuestion?index=${index}&courseId=${courseId}&topicId=${topicId}&difficulty=${difficulty}`, {
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        })
        .then(res => res.text())
        .then(html => {
            document.getElementById("pqjPlayerContainer").innerHTML = html;
        });
    } 
     document.addEventListener('change', function (e) {
        if (e.target.matches('input[type="radio"]')) {
            fetch('/PQJ/SaveAnswer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    attemptId:
                        e.target.dataset.attempt,
                    questionId:
                        e.target.dataset.question,
                    selectedOptionId:
                        e.target.value
                })
            })
            .then(res => res.json())
            .then(data => {
                let selected =
                    e.target.closest('.pqj-option');
                document
                    .querySelectorAll(
                        `input[name="${e.target.name}"]`)
                    .forEach(r => {
                        r.disabled = true;
                    });
                if (data.isCorrect)
                {
                    selected.classList.add('correct-option');
                }
                else
                {
                    selected.classList.add(
                        'wrong-option');
                    document
                        .querySelectorAll(
                            `input[name="${e.target.name}"]`)
                        .forEach(r => {

                            if (r.value ==
                                data.correctOptionId)
                            {
                                r.closest('.pqj-option')
                                 .classList.add(
                                    'correct-option');
                            }
                        });
                }
            });
        }
    });
</script>