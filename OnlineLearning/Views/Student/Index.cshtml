@using OnlineLearning.DTO
@model IEnumerable<StudentDTO>

@Html.AntiForgeryToken()
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between mb-3">
            <h5><i class="bi bi-person-workspace me-2"></i> Student Management</h5>
            <button type="button" class="btn btn-nav-solid"
                    onclick="openGlobalModal('Add New Student', '/Student/Create')">
                <i class="bi bi-plus-lg"></i> Add New Student
            </button>
        </div>
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table id="StudentTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Mobile No</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            
                            <th scope="row">@srNo</th>
                            <td>@item.FullName</td>
                            <td>@item.Email</td>
                            <td>@item.Address</td>
                            <td>@item.Mobile</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-sm"
                                        onclick="openGlobalModal('Edit Student', '@Url.Action("Edit", "Student", new { id = item.UserID })')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm text-danger"
                                        onclick="confirmDelete('@item.UserID')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#StudentTable').DataTable({
                "dom": "<'row mb-3 mt-2 px-3'<'col-auto'l><'col-auto ms-auto'f>>tr<'row px-3 pb-3'<'col-auto'i><'col-auto ms-auto'p>>",
                "language": { "search": "", "searchPlaceholder": "Search students..." }
            });
            $('.dataTables_filter input').addClass('form-control shadow-none');
        });
        function confirmDelete(id) {
            showConfirm(
                "Delete Student",
                "Are you sure you want to delete this student? This record will be removed permanently.",
                function() {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/Student/DeleteConfirmed',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function(response) {
                            showNotification('Success', 'Student deleted successfully!', 'success');
                            
                            setTimeout(() => location.reload(), 1000);
                        },
                        error: function(xhr) {
                            showNotification('Error', 'Could not delete Student. Error: ' + xhr.statusText, 'error');
                        }
                    });
                }
            );
        }
        function  previewFile(event){
            var reader= new FileReader();
            reader.onload=function(){
                var output=document.getElementById('previewimage');
                output.src=reader.result;
            }
            reader.readAsDataURL(event.target.files[0]);
        }
        $(document).on('submit', '#studentForm', function (e) {
            e.preventDefault();
    
            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            var originalBtnText = submitBtn.text();  
            var formData = new FormData(this); 
            var token = $('input[name="__RequestVerificationToken"]').val(); 
             $.ajax({
                 url: form.attr('action'),
                 type: 'POST',
                 data: formData,
                 processData: false,
                 contentType: false,
                 headers: {
                     "RequestVerificationToken": token
                 },
                 beforeSend: function () {
                     submitBtn.prop('disabled', true).text('Saving...');
                 },
                success: function (response) {
                    if(response.success){
                       $('#globalModal').modal('hide');
                       showNotification('Success', response.message, 'success');
                       setTimeout(() => location.reload(), 3500);
                    }
                    else{
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    showNotification('Error', 'Unable to save data. Please check your inputs.', 'error');
                }, 
                complete: function () {
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        });
    </script>
}