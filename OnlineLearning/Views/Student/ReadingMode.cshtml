@model OnlineLearning.Models.StudentReadingVM
 
 
@Html.AntiForgeryToken()

<div class="container-fluid my-3 px-4"> 
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm rounded-4 p-2" style="background-color: #1c2541;">
                <div class="d-flex justify-content-around text-center mode-tabs">
                    <a href="javascript:void(0);" onclick="loadModeContent('Video', this)" class="mode-btn btn border-0 flex-fill py-2 text-light fw-bold" style="opacity: 0.7;">
                        <i class="bi bi-play-circle-fill me-1"></i> VIDEO MODE <br>
                        <small class="fw-normal" style="font-size: 11px;">Learn with Video + Notes</small>
                    </a> 
                    <a href="javascript:void(0);" onclick="loadModeContent('Reading', this)" class="mode-btn btn flex-fill py-2 shadow-sm active-mode-btn active-mode">
                        <i class="bi bi-book-half me-1"></i> READING MODE (Notes + PYQs) <br>
                        <small class="fw-bold" style="font-size: 11px; opacity: 0.85;">Study Notes + PYQs with Explanations</small>
                    </a>
                    <a href="javascript:void(0);" onclick="loadModeContent('Test', this)" class="mode-btn btn border-0 flex-fill py-2 text-light fw-bold" style="opacity: 0.7;">
                        <i class="bi bi-file-earmark-text-fill me-1"></i> TEST MODE (PYQ) <br>
                        <small class="fw-normal" style="font-size: 11px;">Practice PYQs in Test Environment</small>
                    </a>
                </div>
            </div>
        </div>
    </div> 
    <div class="row g-3"> 
        <div class="col-md-3">
            <div class="card-body p-2">
                    @if (Model != null && Model.EnrolledCourses != null && Model.EnrolledCourses.Any())
                    {
                        <div class="accordion accordion-flush" id="courseAccordion">
                            @foreach (var course in Model.EnrolledCourses)
                            {
                                <div class="accordion-item border-0 mb-2">
                                    <h2 class="accordion-header" id="heading_@course.CourseId">
                                        <button class="accordion-button collapsed bg-light rounded-3 fw-bold text-dark small py-2 px-3 shadow-none"
                                                type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@course.CourseId">
                                            <i class="bi bi-book me-2 text-primary"></i> @course.CourseTitle
                                        </button>
                                    </h2>
                                    <div id="collapse_@course.CourseId" class="accordion-collapse collapse" data-bs-parent="#courseAccordion">
                                        <div class="accordion-body px-2 py-1">
                                            <div class="list-group list-group-flush small">
                                                @if (course.Sections != null && course.Sections.Any())
                                                {
                                                   foreach (var sec in course.Sections)
                                                   {
                                                       <a href="javascript:void(0);" onclick="loadSectionQuestions(this, @course.CourseId, @sec.SectionId)"
                                                          class="list-group-item list-group-item-action border-0 rounded my-1 text-secondary section-link">
                                                           <i class="bi bi-chevron-right me-1 text-muted small"></i> @sec.SectionTitle
                                                       </a>
                                                   }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small ps-3">No sections available</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small text-center p-3">No enrolled courses found.</p>
                    }
                </div>
        </div> 
        <div class="col-md-9">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 maincontent" style="min-height: 75vh; background-color: #f8f9fa;">
                    <div class="text-center py-5 text-muted my-5">
                        <i class="bi bi-arrow-left-circle display-4 text-primary"></i>
                        <h5 class="fw-bold mt-3">Select a section from the left sidebar</h5>
                    </div>
                </div>
            </div>
        </div>  
    </div>
</div>

@section Scripts {
    <script> 
        var currentCourseId = 0;
        var currentSectionId = 0;
        var currentMode = 'Reading';
        function escapeHtml(string) {
            var matchHtmlRegExp = /["'&<>]/;
            var match = matchHtmlRegExp.exec(string);
            if (!match) return string;
            var escape = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            return string.replace(/["'&<>]/g, function (s) { return escape[s]; });
        }

       
        function loadModeContent(modeType, element) {
            currentMode = modeType; 
            $('.mode-btn').removeClass('active-mode-btn text-dark fw-bold').addClass('text-light border-0').css('background-color', 'transparent');
            $(element).removeClass('text-light border-0').addClass('active-mode-btn'); 
            if (currentCourseId > 0 && currentSectionId > 0) {
                fetchContent();
            } 
        }
    function loadSectionQuestions(element, courseId, sectionId) {
        currentCourseId = courseId;
        currentSectionId = sectionId;
        $('.section-link').removeClass('active-section-style').addClass('text-secondary');
            $(element).removeClass('text-secondary').addClass('active-section-style');
        fetchContent();
    }
       function fetchContent() {
          $('.maincontent').html(`
              <div class="text-center py-5">
                  <div class="spinner-border text-primary" role="status"></div>
               <p class="text-muted mt-2 small">Loading ${currentMode} content...</p>
              </div>
          `);
          
          var token = $('input[name="__RequestVerificationToken"]').val(); 
          $.ajax({
              url: '/Student/LoadModePartial', 
              type: 'GET', 
              data: { mode: currentMode, courseId: currentCourseId, sectionId: currentSectionId },
              headers: { "RequestVerificationToken": token },
              success: function (responseHtml) {
                  $('.maincontent').html(responseHtml);
              },
              error: function() {
                  $('.maincontent').html('<div class="text-center text-danger py-5">Failed to load content. Please try again.</div>');
              }
          });
       }
     
        function loadQuestions(courseId, sectionId) { 
            $('.section-link').removeClass('active bg-primary text-white');
            event.currentTarget.classList.add('active', 'bg-primary', 'text-white');
              
            $('#questionsContainer').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 small">Loading questions...</p>
                </div>
            `);
              
            $.get('/Student/GetQuestionsPartial', { courseId: courseId, sectionId: sectionId }, function (htmlResponse) {
                $('#questionsContainer').html(htmlResponse);
            }).fail(function() {
                $('#questionsContainer').html('<div class="text-center text-danger py-5">Failed to load questions. Please try again.</div>');
            });
        }
    </script>
}