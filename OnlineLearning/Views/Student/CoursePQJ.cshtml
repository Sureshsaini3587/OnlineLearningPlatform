@using OnlineLearning.DTO
@model PqjCourseQuizVM
@{
    Layout = "~/Views/Shared/Web/_StudentLayout.cshtml";
    ViewData["Title"] = $"PQJ | {Model.CourseTitle}";
}

<style>
    .pqj-container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 0 1rem;
    }
    /* Hide all question cards by default */
    .question-card {
        display: none;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        border-radius: 1rem;
    }
    /* Only display the card with the .active class */
    .question-card.active {
        display: block;
        animation: fadeIn 0.4s ease-in-out;
    }
    .option-wrapper {
        display: block;
        position: relative;
        padding: 1rem 1rem 1rem 3rem;
        margin-bottom: 0.75rem;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        cursor: pointer;
        user-select: none;
        transition: all 0.2s ease;
    }
    .option-wrapper:hover {
        background-color: #f1f5f9;
        border-color: #cbd5e1;
    }
    .option-wrapper input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }
    .option-marker {
        position: absolute;
        top: 50%;
        left: 1.25rem;
        transform: translateY(-50%);
        height: 1.25rem;
        width: 1.25rem;
        background-color: #fff;
        border: 2px solid #cbd5e1;
        border-radius: 50%;
    }
    .option-wrapper input:checked ~ .option-marker {
        background-color: #111827;
        border-color: #111827;
    }
    .option-wrapper.correct-choice {
        background-color: #d1fae5 !important;
        border-color: #10b981 !important;
        color: #065f46 !important;
    }
    .option-wrapper.incorrect-choice {
        background-color: #fee2e2 !important;
        border-color: #ef4444 !important;
        color: #991b1b !important;
    }
    .explanation-box {
        display: none;
        background-color: #f0fdf4;
        border-left: 4px solid #10b981;
        border-radius: 0.25rem;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="pqj-container">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <span class="text-primary fw-bold text-uppercase small tracking-wider">Practice Question Journal</span>
            <h2 class="fw-bold text-dark mt-1">@Model.CourseTitle</h2>
        </div>
        <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill" id="quizProgressTracker">
            Question 1 of @Model.Questions.Count
        </span>
    </div>

    <div id="quizForm">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="question-card p-4 mb-4 shadow-sm @(i == 0 ? "active" : "")" 
                 data-index="@i" 
                 data-question-id="@q.QuestionId" 
                 data-correct-answer="@q.CorrectOption">
                
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-secondary text-white rounded-pill px-3 py-1.5">Module Unit</span>
                    <span class="text-muted small fw-medium"><i class="bi bi-journal-bookmark me-1"></i> @q.LectureTitle</span>
                </div>
                
                <h5 class="fw-bold mb-4">@q.QuestionText</h5>

                <div class="options-container">
                    <label class="option-wrapper" data-option-code="A">
                        <input type="radio" name="q_@q.QuestionId" value="A" onclick="checkSelection(this, '@q.QuestionId')">
                        <span class="option-marker"></span>
                        <strong>A.</strong> @q.OptionA
                    </label>
                    <label class="option-wrapper" data-option-code="B">
                        <input type="radio" name="q_@q.QuestionId" value="B" onclick="checkSelection(this, '@q.QuestionId')">
                        <span class="option-marker"></span>
                        <strong>B.</strong> @q.OptionB
                    </label>
                    <label class="option-wrapper" data-option-code="C">
                        <input type="radio" name="q_@q.QuestionId" value="C" onclick="checkSelection(this, '@q.QuestionId')">
                        <span class="option-marker"></span>
                        <strong>C.</strong> @q.OptionC
                    </label>
                    <label class="option-wrapper" data-option-code="D">
                        <input type="radio" name="q_@q.QuestionId" value="D" onclick="checkSelection(this, '@q.QuestionId')">
                        <span class="option-marker"></span>
                        <strong>D.</strong> @q.OptionD
                    </label>
                </div>

                <div class="explanation-box p-3 mt-3" id="explain_@q.QuestionId">
                    <div class="d-flex align-items-center mb-1 text-success fw-bold">
                        <i class="bi bi-check-circle-fill me-2"></i> Solution & Explanation
                    </div>
                    <p class="mb-0 text-secondary small">@q.Explanation</p>
                </div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill" id="btnPrev" onclick="navigateQuestion(-1)" disabled>
                <i class="bi bi-chevron-left me-2"></i> Previous
            </button>
            
            <button type="button" class="btn btn-dark px-4 py-2 rounded-pill" id="btnNext" onclick="navigateQuestion(1)">
                Next <i class="bi bi-chevron-right ms-2"></i>
            </button>
        </div>
    </div>
</div>
 
    <script>
        let currentIdx = 0;
        // Read total available questions directly from server render context safely
        const totalQuestions = @Model.Questions.Count;

        function checkSelection(radioInput, questionId) {
            const card = radioInput.closest('.question-card');
            const correctAnswer = card.getAttribute('data-correct-answer');
            const selectedAnswer = radioInput.value;
            const optionWrappers = card.querySelectorAll('.option-wrapper');
            
            optionWrappers.forEach(wrapper => {
                const currentOptionCode = wrapper.getAttribute('data-option-code');
                wrapper.classList.remove('correct-choice', 'incorrect-choice');
                
                // Lockdown options once choice is registered
                const inputElement = wrapper.querySelector('input');
                if(inputElement) inputElement.disabled = true;

                if (currentOptionCode === correctAnswer) {
                    wrapper.classList.add('correct-choice');
                }
                if (currentOptionCode === selectedAnswer && selectedAnswer !== correctAnswer) {
                    wrapper.classList.add('incorrect-choice');
                }
            });

            const explanationBox = document.getElementById(`explain_${questionId}`);
            if (explanationBox) {
                explanationBox.style.display = 'block';
            }
        }

        function navigateQuestion(direction) {
            const questions = document.querySelectorAll('.question-card');
            
            // Remove active status from old step layout node 
            questions[currentIdx].classList.remove('active');
            
            // Advance/regress pointer index boundary tracker values
            currentIdx += direction;
            
            // Safety guard: Caps routing inside strict data arrays constraints boundaries
            if (currentIdx < 0) currentIdx = 0;
            if (currentIdx >= totalQuestions) {
                // If they click next past the last question, we gracefully exit back to the previous workspace view
                alert("🎉 Spectacular job finishing today's PQJ workspace exercises!");
                window.history.back();
                return;
            }

            // Assign visibility focus layer flag tags onto next active question node
            questions[currentIdx].classList.add('active');
            
            // Render interface update parameters properties variables values texts configurations
            document.getElementById('quizProgressTracker').innerText = `Question ${currentIdx + 1} of ${totalQuestions}`;
            
            // Evaluation conditions controlling execution states layouts configuration
            document.getElementById('btnPrev').disabled = (currentIdx === 0);
            
            // Change "Next" button text dynamically to "Finish" when arriving at the final card
            const nextBtn = document.getElementById('btnNext');
            if (currentIdx === totalQuestions - 1) {
                nextBtn.innerHTML = `Finish PQJ <i class="bi bi-flag-fill ms-2"></i>`;
                nextBtn.classList.replace('btn-dark', 'btn-success');
            } else {
                nextBtn.innerHTML = `Next <i class="bi bi-chevron-right ms-2"></i>`;
                nextBtn.classList.replace('btn-success', 'btn-dark');
            }
        }
    </script>
 