@{
    
    ViewData["Title"] = "Watch Course";
}

<div class="watch-layout">
    <div class="watch-main">
        <div class="watch-player">
            <div class="play-button-glow"><i class="bi bi-play-fill"></i></div>
            <span class="preview-pill">Now Playing</span>
        </div>

        <div class="watch-content-card">
            <h2>Lesson 07: Dashboard Metrics and Learning Flow</h2>
            <p>
                Understand how to structure a premium student dashboard, organize watch flow,
                and build a better learning experience.
            </p>

            <div class="watch-actions">
                <button class="btn btn-plan">Mark as Complete</button>
                <a href="/PQJ" class="btn btn-outline-dark rounded-pill px-4 py-3">Take PQJ</a>
            </div>
        </div>
    </div>

    <div class="watch-sidebar">
        <div class="watch-sidebar-card">
            <div class="panel-head">
                <h4>Course Content</h4>
            </div>

            <div class="watch-lesson-list">
                <div class="watch-lesson-item active">
                    <div>
                        <strong>Lesson 07</strong>
                        <span>Dashboard Metrics</span>
                    </div>
                    <i class="bi bi-play-circle-fill"></i>
                </div>

                <div class="watch-lesson-item">
                    <div>
                        <strong>Lesson 08</strong>
                        <span>Subscription UX</span>
                    </div>
                    <i class="bi bi-play-circle"></i>
                </div>

                <div class="watch-lesson-item locked">
                    <div>
                        <strong>Lesson 09</strong>
                        <span>Premium Analytics</span>
                    </div>
                    <i class="bi bi-lock-fill"></i>
                </div>

                <div class="watch-lesson-item locked">
                    <div>
                        <strong>Lesson 10</strong>
                        <span>Advanced PQJ Review</span>
                    </div>
                    <i class="bi bi-lock-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>