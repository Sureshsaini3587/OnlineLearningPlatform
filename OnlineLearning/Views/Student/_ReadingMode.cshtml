@model IEnumerable<OnlineLearning.Models.ReadingQuestionVM>

<div class="reading-content-wrapper">
   
    <div class="p-3 rounded-4 shadow-sm mb-4" style="background: linear-gradient(135deg, #2ec5a7, #ffb38a); color: #101726;">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="fw-bold mb-1"><i class="bi bi-book-half me-2"></i> Enrolled Courses & Reading Content</h4>
                <p class="small mb-0 opacity-75">Overview of your enrolled courses and sections.</p>
            </div>
            <span class="badge bg-dark text-white px-3 py-2 fw-bold">Active View</span>
        </div>
    </div>
     
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3 bg-white">
        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-journals me-2"></i> Your Enrolled Courses</h5>

        @if (Model != null)
        {
            <div class="row g-3">
                  @foreach (var q in Model)
                    {
                    <div class="col-md-12">
                        <div class="p-3 border rounded-3 bg-light">
                           
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@q.QuestionTextEn</h6>
                                    <p class="text-muted small mb-1">@q.QuestionTextHi</p> 
                                    <span class="badge bg-info text-dark small">Level: @q.DifficultyLevel</span>
                                </div>
                                <span class="text-muted small">Year: @q.Year.ToString("dd MMM yyyy")</span>
                            </div>
                             
                            <div class="mt-3 pt-2 border-top">
                                <span class="fw-bold text-secondary small d-block mb-2">Course Sections:</span>
                                @if (q.Options != null && q.Options.Any())
                                {
                                    <ul class="list-unstyled mb-0 small">
                                        @foreach (var sec in q.Options)
                                        {
                                            <li class="py-1 text-dark">
                                                <i class="bi bi-check-circle-fill text-success me-1"></i> @sec.OptionTextEn
                                                <i class="bi bi-check-circle-fill text-success me-1"></i> @sec.OptionTextHi
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">No sections available for this course.</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted border rounded-3 bg-light">
                <i class="bi bi-info-circle me-1">Details not found.</i>
            </div>
        }
    </div>
</div>