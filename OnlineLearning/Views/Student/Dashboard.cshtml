@using OnlineLearning.Views.Services
@model StudentDashboardVM
@inject ProtectorService protector
@{
    ViewData["Title"] = "Dashboard";
    //Layout = "~/Views/Shared/Web/_StudentLayout.cshtml";
}

<div class="dashboard-header">
    <div>
        <h1>Welcome back, @Model.UserName 👋</h1>
        <p>Track your learning, continue lessons, and monitor your PQJ performance.</p>
    </div>
    <a href="/WebHome/Courses" class="btn btn-plan">Explore More Courses</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>Active Plan</span>
            <strong>@Model.PlanName</strong>
            <small>@Model.DaysLeft days left</small>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>Courses Enrolled</span>
            <strong>@Model.TotalCourses</strong>
            <small>@Model.InProgressCourses in progress</small>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>Hours Watched</span>
            <strong>@Model.HoursWatched h</strong>
            <small>This month</small>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>PQJ Score</span>
            <strong>@Model.PQJScore%</strong>
            <small>Average performance</small>
        </div>
    </div>
</div>

<div class="row g-4">
     
    <div class="col-xl-8">
         
        <div class="student-panel-card">
            <div class="panel-head">
                <h4>Continue Learning</h4>
                <a href="/Student/Watch">View all</a>
            </div>

            @if (Model.ContinueCourse != null)
            {
                <div class="continue-course-card">
                    <div class="continue-thumb">
                        <img src="@Model.ContinueCourse.Thumbnail" alt="Course" />
                    </div>

                    <div class="continue-body">
                        <span class="continue-label">Currently Watching</span>
                        <h3>@Model.ContinueCourse.Title</h3>
                        <p>Resume your last watched lesson</p>

                        <div class="continue-progress">
                            <div class="progress-track">
                                <div class="progress-fill"
                                     style="width:@Model.ContinueCourse.Progress%;">
                                </div>
                            </div>
                            <span>@Model.ContinueCourse.Progress% completed</span>
                        </div>

                        <a href="/Student/Watch/@Model.ContinueCourse.CourseId"
                               class="btn btn-plan mt-3">
                            Resume Course
                        </a>
                    </div>
                </div>
            }
            else
            {
                <p>No active course found.</p>
            }
        </div> 
        <div class="student-panel-card mt-4">
            <div class="panel-head">
                <h4>Recent Courses</h4>
                <a href="/WebHome/Courses">Browse more</a>
            </div>

            <div class="row g-4">
                @if (Model.RecentCourses != null && Model.RecentCourses.Any())
                {
                    foreach (var course in Model.RecentCourses)
                    {
                        <div class="col-md-6">
                            <div class="mini-course-card">
                                <img src="@course.Thumbnail" alt="@course.CourseTitle" />

                                <div class="mini-course-body">
                                    <h5>@course.CourseTitle</h5>
                                    <p>Watch lessons and improve with PQJ practice.</p> 
                                    <a href="/WebHome/CourseDetails/@protector.Encrypt(course.CourseId)" class="btn btn-course-view">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>No recent courses available.</p>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="col-xl-4">

        <!-- PQJ Performance -->
        <div class="student-panel-card">
            <div class="panel-head">
                <h4>PQJ Performance</h4>
            </div>

            <div class="score-circle-wrap">
                <div class="score-circle">@Model.PQJScore%</div>
                <p>Strong performance this week. Keep solving advanced sets.</p>
            </div>
        </div>

        <!-- Goals -->
        <div class="student-panel-card mt-4">
            <div class="panel-head">
                <h4>Upcoming Goals</h4>
            </div>

            <div class="goal-list">
                <div class="goal-item">
                    <strong>Complete current module</strong>
                    <span>Today</span>
                </div>

                <div class="goal-item">
                    <strong>Attempt next PQJ set</strong>
                    <span>Tomorrow</span>
                </div>

                <div class="goal-item">
                    <strong>Renew subscription</strong>
                    <span>@Model.DaysLeft days left</span>
                </div>
            </div>
        </div>

    </div>
</div>