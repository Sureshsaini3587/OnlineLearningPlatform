@using OnlineLearning.Helpers
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/Web/_StudentLayout.cshtml";
}

<div class="dashboard-header">
    <div>
        <h1>Welcome back, @UserHelper.GetUserName(User) 👋</h1>
        <p>Track your learning, continue lessons, and monitor your PQJ performance.</p>
    </div>
    <a href="/WebHome/Courses" class="btn btn-plan">Explore More Courses</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>Active Plan</span>
            <strong>Quarterly Pro</strong>
            <small>27 days left</small>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>Courses Enrolled</span>
            <strong>08</strong>
            <small>2 in progress</small>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>Hours Watched</span>
            <strong>42h</strong>
            <small>This month</small>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="dash-stat-card">
            <span>PQJ Score</span>
            <strong>88%</strong>
            <small>Average performance</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="student-panel-card">
            <div class="panel-head">
                <h4>Continue Learning</h4>
                <a href="/Student/Watch">View all</a>
            </div>

            <div class="continue-course-card">
                <div class="continue-thumb">
                    <img src="https://picsum.photos/700/420?random=111" alt="Course" />
                </div>
                <div class="continue-body">
                    <span class="continue-label">Currently Watching</span>
                    <h3>Advanced Web Platform UI</h3>
                    <p>Lesson 07 · Dashboard metrics and modern layout flow</p>

                    <div class="continue-progress">
                        <div class="progress-track">
                            <div class="progress-fill" style="width: 68%;"></div>
                        </div>
                        <span>68% completed</span>
                    </div>

                    <a href="/Student/Watch" class="btn btn-plan mt-3">Resume Course</a>
                </div>
            </div>
        </div>

        <div class="student-panel-card mt-4">
            <div class="panel-head">
                <h4>Recent Courses</h4>
                <a href="/Courses">Browse more</a>
            </div>

            <div class="row g-4">
                @for (int i = 1; i <= 2; i++)
                {
                    <div class="col-md-6">
                        <div class="mini-course-card">
                            <img src="https://picsum.photos/400/260?random=@(30 + i)" />
                            <div class="mini-course-body">
                                <h5>Premium Course @i</h5>
                                <p>Watch lessons and improve with PQJ practice.</p>
                                <a href="/Courses/Details/@i">Open Course</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="student-panel-card">
            <div class="panel-head">
                <h4>PQJ Performance</h4>
            </div>

            <div class="score-circle-wrap">
                <div class="score-circle">88%</div>
                <p>Strong performance this week. Keep solving advanced sets.</p>
            </div>
        </div>

        <div class="student-panel-card mt-4">
            <div class="panel-head">
                <h4>Upcoming Goals</h4>
            </div>

            <div class="goal-list">
                <div class="goal-item">
                    <strong>Complete Module 4</strong>
                    <span>Due today</span>
                </div>
                <div class="goal-item">
                    <strong>Attempt PQJ Set 03</strong>
                    <span>Tomorrow</span>
                </div>
                <div class="goal-item">
                    <strong>Renew plan reminder</strong>
                    <span>After 27 days</span>
                </div>
            </div>
        </div>
    </div>
</div>