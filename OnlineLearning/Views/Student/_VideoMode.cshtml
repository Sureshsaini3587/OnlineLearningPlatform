@model VideoVM
@{
    var course = ViewBag.CourseDetails as CourseDetailsVM;
    string cleanEmbedUrl = "";

    if (Model != null && !string.IsNullOrEmpty(Model.VideoUrl))
    {
        var match = System.Text.RegularExpressions.Regex.Match(Model.VideoUrl, @"(?:(?:v|embed|vi|youtu\.be)\/|(?:(?:watch|\?)\?v(?:i)?=|\&v(?:i)?=))([^#\&\? ]+)");
        cleanEmbedUrl = match.Success ? $"https://www.youtube.com/embed/{match.Groups[1].Value}?rel=0&modestbranding=1" : Model.VideoUrl;
    }
}

<div class="row g-4"> 
    <div class="col-lg-8">
        @if (Model != null)
        {
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-dark mb-3">
                <div class="ratio ratio-16x9">
                    <iframe src="@cleanEmbedUrl" title="@Model.Title" allowfullscreen allow="autoplay; encrypted-media"></iframe>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="fw-bold text-dark mb-0">@Model.Title</h4>
                    @if (Model.IsDemo)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill small">Free Demo</span>
                    }
                </div>
                <span class="text-muted small"><i class="bi bi-clock me-1"></i> Duration: @Model.Duration mins</span>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <div class="py-5 text-muted">
                    <i class="bi bi-play-circle display-4 text-primary mb-3"></i>
                    <h5 class="fw-bold text-dark">Select a video from the list</h5>
                    <p class="small text-muted mb-0">Choose any video module from the right sidebar to start watching.</p>
                </div>
            </div>
        }
    </div>
     
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-collection-play me-2 text-primary"></i> Video Modules</h6>
            </div>
            <div class="card-body p-3" style="max-height: 65vh; overflow-y: auto;">
                @if (course?.Sections != null && course.Sections.Any())
                {
                    @foreach (var section in course.Sections.OrderBy(s => s.SectionOrder))
                    {
                        <div class="section-title text-uppercase fw-bold text-muted px-2 py-2 mt-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                          
                        </div>

                        if (section.Videos != null && section.Videos.Any())
                        {
                            foreach (var video in section.Videos.OrderBy(v => v.VideoOrder))
                            {
                                bool isCurrent = Model?.VideoId == video.VideoId;
                                <a href="javascript:void(0);" onclick="loadVideoContent(@video.VideoId)"
                                   class="list-group-item list-group-item-action border-0 rounded-3 mb-1 p-2.5 @(isCurrent ? "active-lesson" : "bg-light bg-opacity-50")">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center text-truncate me-2">
                                            <i class="bi @(isCurrent ? "bi-play-circle-fill text-primary" : "bi-play-circle text-muted") me-2 fs-5"></i>
                                            <div class="text-truncate">
                                                <div class="fw-semibold small text-truncate text-dark">@video.Title</div>
                                                <small class="text-muted" style="font-size: 10px;">@video.Duration mins</small>
                                            </div>
                                        </div>
                                        @if (video.IsDemo)
                                        {
                                            <span class="badge bg-success-subtle text-success" style="font-size: 8px;">Demo</span>
                                        }
                                    </div>
                                </a>
                            }
                        }
                    }
                }
                else
                {
                    <div class="text-center text-muted small py-4">No video modules available.</div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .active-lesson {
        background-color: #e0e9ff !important;
        border-left: 4px solid #0d6efd !important;
    }
    .active-lesson .text-dark {
        color: #0d6efd !important;
        font-weight: bold;
    }
</style>