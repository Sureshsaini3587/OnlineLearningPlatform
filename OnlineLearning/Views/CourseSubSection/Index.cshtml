@model IEnumerable<SubSection>

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5>📚 Sub-Section Management</h5>
                @if (ViewBag.SectionTitle != null)
                {
                    <span class="text-muted small">Parent Section: <strong>@ViewBag.SectionTitle</strong></span>
                }
            </div>
            <div>
                <button type="button" class="btn btn-nav-solid"
                        onclick="openGlobalModal('Sub-Section Details', '@Url.Action("Upsert", "CourseSubSection", new { sectionId = ViewBag.SectionId })')">
                    <i class="bi bi-plus-lg"></i> New Sub-Section
                </button>
                <a asp-controller="CourseSection" asp-action="Index" class="btn btn-outline-secondary btn-sm ms-2">
                    <i class="bi bi-arrow-left"></i> Back to Sections
                </a>
            </div>
        </div>
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table class="table table-hover" id="subsectiontable">
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Sub-Section Title</th>
                        <th>Parent Section</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th width="180">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">@srNo</th>
                                <td>@item.SubSectionTitle</td>
                                <td>@(item.CourseSection?.SectionTitle ?? "N/A")</td>
                                <td>@item.SortOrder</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm"
                                            onclick="openGlobalModal('Edit Sub-Section Details', '@Url.Action("Upsert", "CourseSubSection", new { id = item.SubSectionId })')">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm text-danger"
                                            onclick="confirmDelete('@item.SubSectionId')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            srNo++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
 
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#subsectiontable').DataTable({
                "dom": "<'row mb-3 mt-2 px-3'<'col-auto'l><'col-auto ms-auto'f>>tr<'row px-3 pb-3'<'col-auto'i><'col-auto ms-auto'p>>",
                "language": { "search": "", "searchPlaceholder": "Search Sub-Section..." }
            });
            $('.dataTables_filter input').addClass('form-control shadow-none');
        });

        function confirmDelete(id) {
            showConfirm(
                "Delete Sub-Section",
                "Are you sure you want to delete this sub-section? This record will be removed permanently.",
                function() {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("Delete", "CourseSubSection")',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function(response) { 
                            if(response && response.success) {
                                showNotification('Success', response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showNotification('Error', response ? response.message : 'Deletion failed.', 'error');
                            }
                        },
                        error: function(xhr) {
                            showNotification('Error', 'Could not delete sub-section. Error: ' + xhr.statusText, 'error');
                        }
                    });
                }
            );
        }
         
        $(document).on('submit', '#SubSectionForm', function (e) {
            e.preventDefault();
    
            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            var originalBtnText = submitBtn.text();
            var formData = new FormData(this);
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    "RequestVerificationToken": token
                },
                beforeSend: function () {
                    submitBtn.prop('disabled', true).text('Saving...');
                },
                success: function (response) {
                    if(response && response.success){
                        $('#globalModal').modal('hide');
                        showNotification('Success', response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    }
                    else {
                        showNotification('Error', response ? response.message : 'Failed to save data.', 'error');
                    }
                },
                error: function (xhr) {
                    showNotification('Error', 'Unable to save data. Please check your inputs.', 'error');
                },
                complete: function () {
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        });
    </script>
}