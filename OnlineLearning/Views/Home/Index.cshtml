@using OnlineLearning.Helpers
@model OnlineLearning.Models.DashboardViewModel

<div class="container-fluid py-4"> 
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Dashboard</h2>
            <p class="text-muted">Welcome back, @UserHelper.GetUserName(User). Overview of your platform health.</p>
        </div>
        <button class="btn btn-primary"><i class="bi bi-download"></i> Export Report</button>
    </div> 
    <div class="row g-4 mb-4">
        @await Html.PartialAsync("_StatCard", new StatCardModel("Total Students", Model.TotalStudents.ToString(), "bi-people", "text-primary"))
        @await Html.PartialAsync("_StatCard", new StatCardModel("Active Courses", Model.ActiveCourses.ToString(), "bi-book", "text-success"))
        @await Html.PartialAsync("_StatCard", new StatCardModel("Revenue", $"₹{Model.MonthlyRevenue:N0}", "bi-cash-coin", "text-info"))
        @await Html.PartialAsync("_StatCard", new StatCardModel("Pending Queries", Model.PendingQueries.ToString(), "bi-question-circle", "text-warning"))
    </div>
     
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-4">Revenue Trends</h5>
                    <canvas id="revenueChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Recent Activity</h5>
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.RecentEnrollments)
                        {
                            <div class="list-group-item px-0 border-0 d-flex align-items-center">
                                <div class="avatar bg-light p-2 rounded me-3"><i class="bi bi-person-fill"></i></div>
                                <div>
                                    <div class="fw-semibold">@item.StudentName</div>
                                    <small class="text-muted">Enrolled in @item.PlanName</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>