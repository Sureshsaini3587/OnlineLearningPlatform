@model SubscriptionPlan
 
 
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-block">
                <div class="d-flex justify-content-end  mb-3">
                    <a type="button" class="btn btn-sm btn-outline-primary" asp-controller="Subscription" asp-action="Index">
                        ← Back
                    </a>
                </div>
                <h4 class="sub-title">Plan Details</h4>
                <form asp-action="Edit" method="post">
                    <input asp-for="PlanId" type="hidden" />
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label"> Plan Name *</label>
                        <div class="col-sm-10">
                            <input asp-for="PlanName" class="form-control" />
                            <span asp-validation-for="PlanName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Price *</label>
                        <div class="col-sm-10">
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Duration(days) *</label>
                        <div class="col-sm-10">
                            <input asp-for="DurationInDays" class="form-control" type="number" step="1" min="1" />
                            <span asp-validation-for="DurationInDays" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Description *</label>
                        <div class="col-sm-10">
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-3">
                        <div class="col-sm-10 offset-sm-2">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input"  />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mt-4 d-flex justify-content-end">
                        <div class="col-sm-1">
                            <button type="submit" class="btn btn-success">Save</button>
                        </div> 
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
 