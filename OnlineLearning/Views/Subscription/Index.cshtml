@using OnlineLearning.DTO
@model IEnumerable<SubscriptionPlanDTO>

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between mb-3">
            <h5>📚 Subscription Plan Management</h5>
            <button type="button" class="btn btn-nav-solid"
                    onclick="openGlobalModal('Add New Plan', '/Subscription/Create')">
                <i class="bi bi-plus-lg"></i> New Plan
            </button>
        </div>
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table id="SubscriptionTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Duration (Days)</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@srNo</th>
                            <td>@item.PlanName</td>
                            <td>@item.Price</td>
                            <td>@item.DurationInDays</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-sm"
                                        onclick="openGlobalModal('Edit Plan', '@Url.Action("Edit", "Subscription", new { id = item.PlanId })')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm text-danger"
                                        onclick="confirmDelete('@item.PlanId')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#SubscriptionTable').DataTable({
                "dom": "<'row mb-3 mt-2 px-3'<'col-auto'l><'col-auto ms-auto'f>>tr<'row px-3 pb-3'<'col-auto'i><'col-auto ms-auto'p>>",
                "language": { "search": "", "searchPlaceholder": "Search plans..." }
            });
            $('.dataTables_filter input').addClass('form-control shadow-none');
        });

        function confirmDelete(id) {
            showConfirm(
                "Delete Plan",
                "Are you sure you want to delete this subscription plan? This record will be removed permanently.",
                function() {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/Subscription/DeleteConfirmed',
                        type: 'POST',
                        data: { PlanId: id },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function(response) {
                            if(response.success) {
                                showNotification('Success', 'Plan deleted successfully!', 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showNotification('Error', response.message, 'error');
                            }
                        },
                        error: function(xhr) {
                            showNotification('Error', 'Could not delete Plan. Error: ' + xhr.statusText, 'error');
                        }
                    });
                }
            );
        }
         
        $(document).on('submit', '#planForm', function (e) {
            e.preventDefault();
    
            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            var originalBtnText = submitBtn.text();
            
            // Using Serialize here because we don't have file uploads in the Plan form
            var formData = form.serialize();
            var token = $('input[name="__RequestVerificationToken"]').val();

             $.ajax({
                 url: form.attr('action'),
                 type: 'POST',
                 data: formData,
                 headers: {
                     "RequestVerificationToken": token
                 },
                 beforeSend: function () {
                     submitBtn.prop('disabled', true).text('Saving...');
                 },
                success: function (response) {
                    if(response.success){
                       $('#globalModal').modal('hide');
                       showNotification('Success', response.message, 'success');
                       setTimeout(() => location.reload(), 1500);
                    }
                    else{
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    showNotification('Error', 'Unable to save data. Please check your inputs.', 'error');
                },
                complete: function () {
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        });
    </script>
}