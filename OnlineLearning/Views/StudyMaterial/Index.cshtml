@model IEnumerable<ReadingQuestionVM>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">📖 Student Reading Mode - Question Management</h5>
            <button type="button" class="btn btn-primary btn-sm"
                    onclick="openGlobalModal('Add New Reading Question', '/StudyMaterial/Create')">
                <i class="bi bi-plus-lg me-1"></i> Add New Question
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="ReadingQuestionTable">
                <thead class="table-light">
                    <tr>
                        <th width="60">Q.No</th>
                        <th>Question (EN / HI)</th>
                        <th>Subject / Topic</th>
                        <th>Exam / Year</th>
                        <th>Difficulty</th>
                        <th width="150" class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.QuestionNumber</td>
                            <td>
                                <div class="text-truncate" style="max-width: 300px;" title="@item.QuestionTextEn">
                                    <strong>EN:</strong> @item.QuestionTextEn
                                </div>
                                <div class="text-muted small text-truncate" style="max-width: 300px;" title="@item.QuestionTextHi">
                                    <strong>HI:</strong> @item.QuestionTextHi
                                </div>
                            </td>
                            <td><span class="badge bg-info text-dark">Course ID: @item.CourseId</span></td>
                            <td>
                                <span class="badge bg-secondary">Section ID: @item.SectionId</span>
                                <span class="badge bg-dark">@item.Year</span>
                            </td>
                            <td>
                                @if (item.DifficultyLevel == 1)
                                {
                                    <span class="text-success fw-bold">Easy</span>
                                }
                                else if (item.DifficultyLevel == 2)
                                {

                                    <span class="text-warning fw-bold">Medium</span>
                                }
                                else
                                {

                                    <span class="text-danger fw-bold">Hard</span>
                                }
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        onclick="openGlobalModal('Edit Question', '@Url.Action("Edit","StudyMaterial", new { id = item.QuestionId })')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmDelete('@item.QuestionId')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ReadingQuestionTable').DataTable({
                "dom": "<'row mb-3 mt-2 px-3'<'col-auto'l><'col-auto ms-auto'f>>tr<'row px-3 pb-3'<'col-auto'i><'col-auto ms-auto'p>>",
                "language": { "search": "", "searchPlaceholder": "Search Mapping..." }
            });
            $('.dataTables_filter input').addClass('form-control shadow-none');
        });
        function confirmDelete(id) {
            showConfirm(
                "Delete Qusetion",
                "Are you sure you want to delete this question? This record will be removed permanently.",
                function() {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/StudyMaterial/DeleteConfirmed',
                        type: 'POST',
                        data: { id: id },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function(response) {
                            showNotification('Success', 'Question deleted successfully!', 'success');
                            
                            setTimeout(() => location.reload(), 1000);
                        },
                        error: function(xhr) {
                            showNotification('Error', 'Could not delete questiom. Error: ' + xhr.statusText, 'error');
                        }
                    });
                }
            );
        }
        $(document).on('change', '#CourseId', function (e) { 
            var courseId = $(this).val();
            var sectionDropdown = $('#SectionId');
            
            sectionDropdown.empty();
            sectionDropdown.append('<option value="">-- Select Section --</option>');

            if (courseId) {
                $.get('/StudyMaterial/GetSectionsByCourseId', { courseId: courseId }, function (data) {
                    $.each(data, function (index, item) {
                        sectionDropdown.append($('<option></option>').val(item.id).text(item.title));
                    });
                });
            }
        });
        $(document).on('submit', '#ReadingForm', function (e) {
            e.preventDefault();
    
            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            var originalBtnText = submitBtn.text();
            var formData = new FormData(this);
            var token = $('input[name="__RequestVerificationToken"]').val();
            
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    "RequestVerificationToken": token
                },
                beforeSend: function () {
                    submitBtn.prop('disabled', true).text('Saving...');
                },
                success: function (response) {
                    if(response.success){
                        $('#globalModal').modal('hide');
                        showNotification('Success', response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    }
                    else{
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    showNotification('Error', 'Unable to save data. Please check your inputs.', 'error');
                },
                complete: function () {
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        });
    </script>
}