@model ReadingQuestionVM

<form asp-action="@(Model.QuestionId == 0 ? "Create" : "Edit")"
      method="post" id="ReadingForm" enctype="multipart/form-data" class="needs-validation">
      
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="QuestionId" />

    <div class="modal-body p-4" style="max-height: 75vh; overflow-y: auto;">
        <div class="row g-3">
             
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Question No. *</label>
                <input asp-for="QuestionNumber" class="form-control form-control-sm" type="number" placeholder="101" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Course *</label>
                <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select form-select-sm" required>
                    <option value="">-- Select Course --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Year *</label>
                <input asp-for="Year" class="form-control form-control-sm" type="number" placeholder="2025" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Difficulty *</label>
                <select asp-for="DifficultyLevel" class="form-select form-select-sm">
                    <option value="1">Easy</option>
                    <option value="2">Medium</option>
                    <option value="3">Hard</option>
                </select>
            </div>
             
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Question (English) *</label>
                <textarea asp-for="QuestionTextEn" class="form-control form-control-sm" rows="3" placeholder="Enter question in English..." required></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Question (Hindi) *</label>
                <textarea asp-for="QuestionTextHi" class="form-control form-control-sm" rows="3" placeholder="हिंदी में प्रश्न लिखें..." required></textarea>
            </div>
             
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Section / Chapter *</label>
                <select asp-for="SectionId" asp-items="ViewBag.Sections" class="form-select form-select-sm" required>
                    <option value="">-- Select Section --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Diagram / Map Image (Optional)</label>
                <input type="file" name="DiagramFile" class="form-control form-control-sm" accept="image/*" />
            </div>
             
            <div class="col-md-12 mt-3">
                <div class="p-3 border rounded bg-light">
                    <label class="form-label fw-bold text-dark mb-2">Manage Options & Correct Answer *</label>
                    
                    <div id="optionsContainer">
                        @for (int i = 0; i < 4; i++)
                        {
                            var optTextEn = Model.Options.Count > i ? Model.Options[i].OptionTextEn : "";
                            var optTextHi = Model.Options.Count > i ? Model.Options[i].OptionTextHi : "";
                            var isCorrect = Model.Options.Count > i && Model.Options[i].IsCorrect;

                            <div class="row g-2 mb-2 align-items-center option-row">
                                <div class="col-md-5">
                                    <input name="Options[@i].OptionTextEn" class="form-control form-control-sm" value="@optTextEn" placeholder="Option @(i + 1) (English)" required />
                                </div>
                                <div class="col-md-5">
                                    <input name="Options[@i].OptionTextHi" class="form-control form-control-sm" value="@optTextHi" placeholder="विकल्प @(i + 1) (हिंदी)" required />
                                </div>
                                <div class="col-md-2">
                                    <div class="form-check">
                                        <input type="radio" name="CorrectOptionIndex" value="@i" class="form-check-input" @(isCorrect ? "checked" : "") />
                                        <label class="form-check-label small fw-bold text-success">Correct</label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
             
            <div class="col-md-12">
                <label class="form-label fw-bold text-muted small">Explanation / Notes</label>
                <textarea asp-for="ExplanationText" class="form-control form-control-sm" rows="2" placeholder="Detailed explanation for reading mode..."></textarea>
            </div>

        </div>
    </div>
     
    <div class="modal-footer border-0 p-3 bg-white rounded-bottom">
        <button type="button" class="btn btn-outline-secondary px-4 btn-sm" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-success px-4 shadow-sm btn-sm">
            <i class="bi bi-save me-1"></i> Save Question
        </button>
    </div>
</form> 