@model Course

<form asp-action="@(Model.CourseId == 0 ? "Create" : "Edit")"
      method="post" id="courseForm" enctype="multipart/form-data" class="needs-validation">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseId" />

    <div class="modal-body p-4"> 
        <div class="row g-3"> 
            <div class="col-md-6"> 
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">Course Title <span class="text-danger">*</span></label>
                    <input asp-for="CourseTitle" class="form-control" placeholder="Enter course title" required />
                    <span asp-validation-for="CourseTitle" class="text-danger small"></span>
                </div>
                 
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">Price (₹) <span class="text-danger">*</span></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="399.00" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select" required>
                            <option value="">- Select Category -</option>
                        </select>
                    </div>
                </div>
                 
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">Level <span class="text-danger">*</span></label>
                        <select asp-for="Level" asp-items="ViewBag.Levels" class="form-select" required></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">Language <span class="text-danger">*</span></label>
                        <select asp-for="Language" asp-items="ViewBag.Language" class="form-select" required></select>
                    </div>
                </div>
                 
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small">Instructor <span class="text-danger">*</span></label>
                    <select asp-for="InstructorId" asp-items="ViewBag.Instructor" class="form-select" required></select>
                </div>
            </div>
             
            <div class="col-md-6"> 
                <div class="mb-3 text-center">
                    <label class="form-label fw-bold text-muted small d-block text-start">Course Thumbnail</label>
                     
                    <div class="upload-card rounded-3 p-2 border d-flex align-items-center justify-content-center"
                         onclick="document.getElementById('thumbInput').click()"
                         style="cursor: pointer; border: 2px dashed #dee2e6; height: 160px; width: 240px; margin: 0 auto;">
                         
                        <img id="thumbPreview"
                             src="@(!string.IsNullOrEmpty(Model.Thumbnail) ? Url.Action("GetImage", "Course", new { filename = Model.Thumbnail }) : "")"
                             class="rounded img-fluid"
                             style="max-height: 100%; max-width: 100%; object-fit: cover; display: @(string.IsNullOrEmpty(Model.Thumbnail) ? "none" : "block");" />
                        
                        <span class="text-muted small" id="uploadText" style="display: @(string.IsNullOrEmpty(Model.Thumbnail) ? "block" : "none");">
                            Click to upload
                        </span>
                    </div> 
                    <input type="file" name="ThumbnailFile" id="thumbInput" class="form-control mt-3" accept=".jpg,.jpeg,.png,.webp" onchange="previewFile(event)" />
                    <span class="text-muted small">JPG, PNG, WEBP. Max 2MB.</span>
                </div>
                 
                <div class="mt-4 p-3 border rounded bg-light">
                    <div class="form-check form-switch d-flex justify-content-between align-items-center mb-2">
                        <label class="form-check-label fw-bold" for="pubSwitch">Live Published</label>
                        <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="pubSwitch">
                        </div>
                        <hr />
                        <div class="form-check form-switch d-flex justify-content-between align-items-center">
                            <label class="form-check-label fw-bold" for="actSwitch">Active</label>
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="actSwitch">
                            </div>
                        </div>
                    </div>
                </div>
                 
                <div class="row mt-3">
                    <div class="col-12">
                        <label class="form-label fw-bold text-muted small">Course Description</label>
                        <textarea asp-for="Description" class="form-control" style="height: 100px" placeholder="Enter course details..."></textarea>
                    </div>
                </div>
            </div> 
            <div class="modal-footer border-0 p-4 bg-white rounded-bottom">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
            </div>
        </form>
         