@model CourseCategories
  
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-block">
                <div class="d-flex justify-content-end  mb-3">
                    <a type="button" class="btn btn-sm btn-outline-primary" asp-controller="Course" asp-action="Categories">
                        ← Back
                    </a>
                </div>
                <h4 class="sub-title">Category Details</h4>
                <form asp-action="CategoryEdit" method="post">
                    <input type="hidden" asp-for="CategoryId">
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Category Name *</label>
                        <div class="col-sm-10">
                            <input asp-for="CategoryName" class="form-control" />
                            <span asp-validation-for="CategoryName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-2">
                        <label class="col-sm-2 col-form-label">Parent Category *</label>
                        <div class="col-sm-10">
                            <select asp-for="ParentCategoryId" asp-items="ViewBag.Categories" class="form-control">
                                <option value="">-- Select Category --</option>
                            </select>
                                <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-3">
                        <div class="col-sm-10 offset-sm-2">
                            <div class="form-check">
                                <input asp-for="IsParent" class="form-check-input" />
                                <label class="form-check-label">Is Parent</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input"  />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mt-4 d-flex justify-content-end gap-2">
                        <div class="col-sm-1">
                             <button type="submit" class="btn btn-success">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
 