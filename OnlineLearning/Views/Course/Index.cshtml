@model IEnumerable<CourseDTO>
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between mb-3">
            <h5>📚 Course Management</h5>
            <a asp-action="Create" class="btn btn-primary">+ Add Course</a>
        </div>   
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Thumbnail</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Level</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th width="180">Action</th> 
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1; 
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            
                            <th scope="row">@srNo</th>
                            <td>
                                <img src="~/Uploads/courses/@item.Thumbnail" width="80" class="rounded" />
                            </td>
                            <td>@item.CourseTitle</td>
                            <td>@item.CategoryName</td>
                            <td>@item.LevelName</td>
                            <td>₹@item.Price</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td> 
                                <a asp-action="Edit" title="Edit" asp-route-id="@item.CourseId" class="btn   btn-outline-primary"><i class="icofont icofont-pencil-alt-5"></i></a>
                                <a asp-action="Delete" title="Delete" asp-route-id="@item.CourseId" class="btn   btn-outline-danger"><i class="icofont icofont-ui-delete"></i></a>
                            </td>
                        </tr>
                        srNo++;
                    } 
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="container mt-4">
    

    <table class="table table-hover table-bordered shadow">
        <thead class="table-dark">
            <tr>
               
            </tr>
        </thead>

        <tbody>
           
        </tbody>
    </table>
</div>