@model IEnumerable<CourseDTO> 
@Html.AntiForgeryToken() 
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between mb-3">
            <h5>📚 Course Management</h5>
            <button type="button" class="btn btn-nav-solid"
                    onclick="openGlobalModal('Add New Course', '/Course/Create')">
                <i class="bi bi-plus-lg"></i> New Course
            </button>
        </div>
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table id="CourseTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Thumbnail</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Level</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th scope="row">@srNo</th>
                            <td>
                                <img src="@(!string.IsNullOrEmpty(item.Thumbnail) ? Url.Action("GetImage", "Course", new { filename = item.Thumbnail }) : "")" width="80" class="rounded" />
                            </td>
                            <td>@item.CourseTitle</td>
                            <td>@item.CategoryName</td>
                            <td>@item.LevelName</td>
                            <td>₹@item.Price</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-sm"
                                        onclick="openGlobalModal('Edit Course Details', '@Url.Action("Edit", "Course", new { id = item.CourseId })')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm text-danger"
                                        onclick="confirmDelete('@item.CourseId')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#CourseTable').DataTable({
                "dom": "<'row mb-3 mt-2 px-3'<'col-auto'l><'col-auto ms-auto'f>>tr<'row px-3 pb-3'<'col-auto'i><'col-auto ms-auto'p>>",
                "language": { "search": "", "searchPlaceholder": "Search Course..." }
            });
            $('.dataTables_filter input').addClass('form-control shadow-none');
        });

        function confirmDelete(id) {
            showConfirm(
                "Delete Course",
                "Are you sure you want to delete this course? This record will be removed permanently.",
                function() {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/Course/DeleteConfirmed',
                        type: 'POST',
                        data: { courseId: id },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function(response) {
                            if(response.success) {
                                showNotification('Success',response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showNotification('Error', response.message, 'error');
                            }
                        },
                        error: function(xhr) {
                            showNotification('Error', 'Could not delete Plan. Error: ' + xhr.statusText, 'error');
                        }
                    });
                }
            );
        }
         
        $(document).on('submit', '#courseForm', function (e) {
            e.preventDefault();
    
            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            var originalBtnText = submitBtn.text(); 
            var formData = new FormData(this); 
            var token = $('input[name="__RequestVerificationToken"]').val(); 
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData, // Send the FormData object
                processData: false, // REQUIRED: Don't let jQuery process the data
                contentType: false, // REQUIRED: Don't set the content type (browser handles it)
                headers: {
                    "RequestVerificationToken": token
                },
                beforeSend: function () {
                    submitBtn.prop('disabled', true).text('Saving...');
                },
                success: function (response) {
                    if(response.success){
                        $('#globalModal').modal('hide');
                        showNotification('Success', response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    }
                    else{
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    showNotification('Error', 'Unable to save data. Please check your inputs.', 'error');
                },
                complete: function () {
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        });
                function previewFile(event) {  
            var input = event.target;
            var output = document.getElementById('thumbPreview');
            var text = document.getElementById('uploadText');

            if (input.files && input.files[0]) {
                var reader = new FileReader();
            
                reader.onload = function(e) { 
                    output.src = e.target.result;
                 
                    output.style.display = 'block';
                    output.style.visibility = 'visible';
                 
                    if(text) text.innerText = "Click to change image";
                }
            
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

  