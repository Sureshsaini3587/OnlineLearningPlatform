@model CourseCategories

<form  asp-action="@(Model.CategoryId == 0 ? "CategoryCreate" : "CategoryEdit")"
      method="post" id="CategoryForm" class="needs-validation">
      
    @Html.AntiForgeryToken()

    @if (Model.CategoryId != 0)
        {
            <input type="hidden" asp-for="CategoryId" />
        }

        <div class="modal-body p-4">
            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold text-muted small">Category Name <span class="text-danger">*</span></label>
                        <input asp-for="CategoryName" class="form-control" rows="2" placeholder="Enter category name..." required></input>
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold text-muted small">Parent Category</label>
                    <select asp-for="ParentCategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="ParentCategoryId" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 p-3 border rounded bg-light">
                <div class="form-check form-switch d-flex justify-content-between align-items-center mb-2">
                    <label class="form-check-label fw-bold text-muted small" for="IsParent">Is Parent</label>
                    <input asp-for="IsParent" class="form-check-input" type="checkbox" />
                </div>
                <hr class="my-2" />
                <div class="form-check form-switch d-flex justify-content-between align-items-center">
                    <label class="form-check-label fw-bold text-muted small" for="IsActive">Active</label>
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                </div>
            </div>
        </div>

        <div class="modal-footer border-0 p-3 bg-white rounded-bottom">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-success px-4 shadow-sm">
                <i class="bi bi-save me-1"></i> @(Model.CategoryId == 0 || Model.CategoryId ==null ? "Save Category" : "Update Category")
            </button>
        </div>
</form>