@model Instructor

<form asp-action="@(Model.InstructorId == null || Model.InstructorId == 0 ? "Create" : "Edit")"
      method="post"
      enctype="multipart/form-data"
      id="instructorForm">
    
    @Html.AntiForgeryToken()
    <div class="modal-body">
        @if (Model.InstructorId != null || Model.InstructorId != 0)
        {
            <input type="hidden" asp-for="InstructorId" />
        }

        <div class="row"> 
            <div class="col-md-7">
                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name *</label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email *</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Mobile *</label>
                    <input asp-for="Mobile" class="form-control" oninput="this.value=this.value.replace(/[^0-9]/g,'')" maxlength="10" />
                    <span asp-validation-for="Mobile" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Experience (Years) *</label>
                    <input asp-for="ExperienceYears" class="form-control" type="number" step="1" />
                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                </div>
            </div>
             
            <div class="col-md-5 text-center">
                <label class="form-label fw-bold">Profile Image</label>
                <div class="border p-2 mb-2 rounded">
                    <div class="border p-2 mb-2 rounded">
                        <img id="previewimage"
                             src="@(Model.ProfileImage != null ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.ProfileImage)}" : "/images/default-avatar.png")"
                             class="img-fluid rounded"
                             style="height:120px; width:100%; object-fit:cover;" />
                    </div>
                </div>
                <input type="file" name="ImageFile" accept="image/*" class="form-control" onchange="previewFile(event)" />
                
                <div class="mt-4 text-start">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" id="activeSwitch"   />
                        <label class="form-check-label" for="activeSwitch">Set as Active</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Bio</label>
            <textarea asp-for="Bio" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">
            @(Model.InstructorId == null || Model.InstructorId == 0 ? "Save" : "Save Changes")
        </button>
    </div>
</form>
 