@model Instructor
 
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-block">
                <div class="d-flex justify-content-end  mb-3">
                    <a type="button" class="btn btn-sm btn-outline-primary" asp-controller="Instructor" asp-action="Index">
                        ← Back
                    </a>
                </div>
                <h4 class="sub-title">Instructor Details</h4>
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="InstructorId" />
                    <div class="form-group row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="col-form-label"> Name *</label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label class="col-form-label">Email *</label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label class="col-form-label">Mobile *</label>
                                <input asp-for="Mobile" class="form-control" oninput="this.value=this.value.replace(/[^0-9]/g,'')" maxlength="10" pattern="[0-9]{10}" inputmode="numeric" />
                                <span asp-validation-for="Mobile" class="text-danger"></span>
                            </div> 
                            <div class="mb-2">
                                <label class="col-form-label">Experience Years</label>
                                <input asp-for="ExperienceYears" class="form-control" type="number" step="1" />
                                <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                            </div>
                            <div class="mb-2">
                                <label class="col-form-label">Bio</label>
                                <textarea asp-for="Bio" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="mb-2 offset-sm-2">
                                <input asp-for="IsActive" class="form-check-input"  />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-md-4 tex-center">
                            <label class="mb-2">Profile Image</label>
                            <div class="border p-3 mb-2">
                                @if (Model.ProfileImage != null)
                                {  
                                    <img id="previewimage" src="data:image/;base64,@Convert.ToBase64String(Model.ProfileImage)" class="img-fluid rounded" style="height:150px;" />

                                }
                                else
                                {
                                    <img id="previewimage" src="" class="img-fluid rounded" style="height:150px;" /> 
                                } 
                            </div>
                            <input type="file" asp-for="ImageFile" accept="image" class="form-control" onchange="previewFile(event)" />
                        </div>
                    </div>
                    <div class="form-group row mt-4 d-flex justify-content-end">
                        <div class="col-sm-1">
                            <button type="submit" class="btn btn-success">Save</button>
                        </div> 
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    function  previewFile(event){
        var reader= new FileReader();
        reader.onload=function(){
            var output=document.getElementById('previewimage');
            output.src=reader.result;
        }
        reader.readAsDataURL(event.target.files[0]);
     }
</script>