@model IEnumerable<PQJQuestion>
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between mb-3">
            <h5>📚 PQJ Management</h5>
            <button type="button" class="btn btn-nav-solid"
                    onclick="openGlobalModal('Add Question', '/PQJQuestion/Create')">
                <i class="bi bi-plus-lg"></i> Add Question
            </button>
        </div>
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table id="PQJTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Question</th>
                        <th>Type</th>
                        <th>Marks</th>
                        <th width="180">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (var item in Model)
                    { 
                        <tr>
                            
                            <th scope="row">@srNo</th>
                            <td>@item.QuestionText</td>
                            <td>@item.QuestionType</td>
                            <td>@item.Marks</td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-sm"
                                        onclick="openGlobalModal('Edit Question Details', '@Url.Action("Edit", "PQJQuestion", new { id = item.QuestionId })')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm text-danger"
                                        onclick="confirmDelete('@item.QuestionId')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td> 
                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
 
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#PQJTable').DataTable({
                "dom": "<'row mb-3 mt-2 px-3'<'col-auto'l><'col-auto ms-auto'f>>tr<'row px-3 pb-3'<'col-auto'i><'col-auto ms-auto'p>>",
                "language": { "search": "", "searchPlaceholder": "Search PQJ..." }
            });
            $('.dataTables_filter input').addClass('form-control shadow-none');
        });
        $(document).on('change', '#courseId', function () { 
              let courseId = this.value;
              let topicDropdown = document.getElementById("section");
              topicDropdown.innerHTML = `<option value="">Loading...</option>`;
              if (!courseId) {
                  topicDropdown.innerHTML = `<option value="">-- Select Section --</option>`;
                  return;
              }

             fetch(`/WebHome/GetTopicsByCourse?courseId=${courseId}`)
                 .then(res => res.json())
                 .then(data => {
                     topicDropdown.innerHTML = `<option value="">-- Select Section --</option>`;
                     data.forEach(t => {
                         topicDropdown.innerHTML += `<option value="${t.sectionId}">${t.sectionTitle}</option>`;
                     });
                 })
                 .catch(() => {
                     topicDropdown.innerHTML = `<option value="">Error loading Section</option>`;
                 });
         }); 
        
        function confirmDelete(id) {
            showConfirm(
                "Delete Question",
                "Are you sure you want to delete this question? This record will be removed permanently.",
                function() {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/PQJQuestion/DeleteConfirmed',
                        type: 'POST',
                        data: { QuestionId: id },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function(response) {
                            if(response.success) {
                                showNotification('Success',response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showNotification('Error', response.message, 'error');
                            }
                        },
                        error: function(xhr) {
                            showNotification('Error', 'Could not delete question. Error: ' + xhr.statusText, 'error');
                        }
                    });
                }
            );
        }
         
        $(document).on('submit', '#QuestionForm', function (e) {
            e.preventDefault();
    
            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            var originalBtnText = submitBtn.text();
            var formData = new FormData(this);
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData, 
                processData: false, 
                contentType: false, 
                headers: {
                    "RequestVerificationToken": token
                },
                beforeSend: function () {
                    submitBtn.prop('disabled', true).text('Saving...');
                },
                success: function (response) {
                    if(response.success){
                        $('#globalModal').modal('hide');
                        showNotification('Success', response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    }
                    else{
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    showNotification('Error', 'Unable to save data. Please check your inputs.', 'error');
                },
                complete: function () {
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        });
                function previewFile(event) {
            var input = event.target;
            var output = document.getElementById('thumbPreview');
            var text = document.getElementById('uploadText');

            if (input.files && input.files[0]) {
                var reader = new FileReader();
            
                reader.onload = function(e) {
                    output.src = e.target.result;
                 
                    output.style.display = 'block';
                    output.style.visibility = 'visible';
                 
                    if(text) text.innerText = "Click to change image";
                }
            
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}

  