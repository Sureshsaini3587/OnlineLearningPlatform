@model IEnumerable<PQJQuestion>
<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between mb-3">
            <h5>📚 Question Management</h5>
            <a asp-action="Create" class="btn btn-primary">+ Add Question</a>
        </div>   
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Sr.No.</th>
                        <th>Question</th>
                        <th>Type</th>
                        <th>Marks</th>
                        <th width="180">Action</th> 
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            
                            <th scope="row">@srNo</th>
                            <td>@item.QuestionText</td>
                            <td>@item.QuestionType</td>
                            <td>@item.Marks</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.QuestionId" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.QuestionId" class="btn btn-info btn-sm">View</a>
                                <a asp-action="Delete" asp-route-id="@item.QuestionId" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                        srNo++;
                    } 
                </tbody>
            </table>
        </div>
    </div>
</div>
 