@model QuestionVM
   

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-block">

                <div class="d-flex justify-content-end mb-3">
                    <a class="btn btn-sm btn-outline-primary"
                           asp-controller="PQJQuestion" asp-action="Index">
                        ← Back
                    </a>
                </div>

                <h4 class="sub-title">Edit Question Details</h4>

                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Question.QuestionId" />
                    <div class="row"> 
                        <div class="col-md-12 mb-3">
                            <label>Question *</label>
                            <textarea asp-for="Question.QuestionText" class="form-control"></textarea>
                            <span asp-validation-for="Question.QuestionText" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Course *</label>
                            <select id="courseId" name="Question.CourseId" 
                                    asp-items="ViewBag.Course"
                                    class="form-control">
                                <option value="">-- Select Course --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Section *</label>
                            <select asp-for="Question.CategoryId" id="section"
                                    class="form-control">
                                <option value="">-- Select Section --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Question Type *</label>
                            <select asp-for="Question.QuestionType" 
                                    class="form-control"
                                    id="questionType">
                                @* <option value="1">MCQ</option> *@
                                <option value="2">True/False</option>
                                <option value="3">Descriptive</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Difficulty</label>
                            <select asp-for="Question.DifficultyLevel" class="form-control">
                                <option value="1">Easy</option>
                                <option value="2">Medium</option>
                                <option value="3">Hard</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Marks</label>
                            <input asp-for="Question.Marks" class="form-control" type="number" min="0" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label>Is Trial</label>
                            <select asp-for="Question.IsTrial" class="form-control">
                                <option value="true">True</option>
                                <option value="false">False</option> 
                            </select>
                        </div> 
                    </div>
                    <div id="mcqOptions">
                        <label>Options *</label>
                        <div id="optionsContainer">
                            @for (int i = 0; i < 4; i++)
                            {
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <input asp-for="Options[@i].OptionText"  
                                           class="form-control"
                                           placeholder="Option @(i + 1)" />

                                    <input type="radio" asp-for="CorrectOption" 
                                           value="@i" /> Correct
                                </div>
                            }
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-primary mt-2"
                                onclick="addOption()">
                            + Add Option
                        </button>
                    </div>
                     
                    <div class="mt-3">
                        <label>Explanation</label>
                        <textarea asp-for="Question.Explanation" class="form-control"></textarea>
                    </div>

                    <button type="submit" class="btn btn-success mt-3">
                        Save Question
                    </button>

                </form>

            </div>
        </div>
    </div>
</div>
<script> 
    document.addEventListener("DOMContentLoaded", function () { 
        let courseDropdown = document.getElementById("courseId");
        let sectionDropdown = document.getElementById("section"); 
         
        let selectedCourseId = '@Model.Question.CourseId';
        let selectedSectionId = '@Model.Question.CategoryId';
        console.log(selectedCourseId);
         if (selectedCourseId) { 
                setTimeout(() => { 
                    [...courseDropdown.options].forEach(o => {
                        console.log(o.value);
                        if (o.value == selectedCourseId) {
                    
                            o.selected = true;
                        }
                    }); 
                }, 100);
             loadSections( selectedCourseId,  selectedSectionId  );

         }
        function loadSections(courseId, selectedSection = null) { 
            sectionDropdown.innerHTML =
                `<option value="">Loading...</option>`; 
            if (!courseId) { 
                sectionDropdown.innerHTML =
                    `<option value="">Select Section</option>`; 
                return;
            } 
            fetch(`/WebHome/GetTopicsByCourse?courseId=${courseId}`)
                .then(res => res.json())
                .then(data => { 
                    sectionDropdown.innerHTML =
                        `<option value="">Select Section</option>`; 
                    data.forEach(t => { 
                        let selected =
                            selectedSection == t.sectionId
                                ? "selected"
                                : "";

                        sectionDropdown.innerHTML += `
                            <option value="${t.sectionId}" ${selected}>
                                ${t.sectionTitle}
                            </option>`;
                    });

                })
                .catch(() => { 
                    sectionDropdown.innerHTML =
                        `<option value="">Error loading sections</option>`;
                });
        } 
        courseDropdown.addEventListener("change", function () { 
            loadSections(this.value);
        });  
    });
     
    function addOption() {
        let index = document.querySelectorAll('#optionsContainer .mb-2').length;

        let html = `
            <div class="mb-2 d-flex align-items-center gap-2">
                <input name="Options[${index}].OptionText"
                       class="form-control"
                       placeholder="Option ${index + 1}" />

                <input type="radio"
                       name="CorrectOption"
                       value="${index}" /> Correct
            </div>`;

        document.getElementById('optionsContainer')
            .insertAdjacentHTML('beforeend', html);
    }
    document.getElementById("questionType").addEventListener("change", function () {
        let val = this.value;

        if (val == "3") {  
            document.getElementById("mcqOptions").style.display = "none";
        } else {
            document.getElementById("mcqOptions").style.display = "block";
        }
    });
</script>
 