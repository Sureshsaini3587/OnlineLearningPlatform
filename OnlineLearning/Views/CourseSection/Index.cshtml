@model IEnumerable<CourseSectionDTO>
<div class="card">
    <div class="card-header"> 
        <div class="d-flex justify-content-between mb-3">
            <h5>📚 Course Section Management</h5>
            <button type="button" class="btn btn-nav-solid"
                    onclick="openGlobalModal('Category Details', '/CourseSection/Create')">
                <i class="bi bi-plus-lg"></i> New Section
            </button> 
        </div>
    </div>
    <div class="card-block table-border-style">
        <div class="table-responsive">
            <table class="table table-hover" id="sectiontable">
                <thead>
                    <tr>
                        <th>Sr.No.</th> 
                        <th>Title</th>
                        <th>Course</th> 
                        <th>Order</th> 
                        <th>Status</th>
                        <th width="180">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            
                            <th scope="row">@srNo</th> 
                            <td>@item.SectionTitle</td>
                            <td>@item.CourseName</td>
                            <td>@item.SortOrder</td> 
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm"
                                        onclick="openGlobalModal('Edit Section Details', '@Url.Action("Edit", "CourseSection", new { id = item.SectionId })')">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm text-danger"
                                        onclick="confirmDelete('@item.SectionId')">
                                    <i class="bi bi-trash"></i>
                                </button> 
                            </td>
                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
 
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#sectiontable').DataTable({
                "dom": "<'row mb-3 mt-2 px-3'<'col-auto'l><'col-auto ms-auto'f>>tr<'row px-3 pb-3'<'col-auto'i><'col-auto ms-auto'p>>",
                "language": { "search": "", "searchPlaceholder": "Search Section..." }
            });
            $('.dataTables_filter input').addClass('form-control shadow-none');
        });

        function confirmDelete(id) {
            showConfirm(
                "Delete Section",
                "Are you sure you want to delete this section? This record will be removed permanently.",
                function() {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/CourseSection/DeleteConfirmed',
                        type: 'POST',
                        data: { SectionId: id },
                        headers: {
                            "RequestVerificationToken": token
                        },
                        success: function(response) {
                            if(response.success) {
                                showNotification('Success',response.message, 'success');
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showNotification('Error', response.message, 'error');
                            }
                        },
                        error: function(xhr) {
                            showNotification('Error', 'Could not delete section. Error: ' + xhr.statusText, 'error');
                        }
                    });
                }
            );
        }
         
        $(document).on('submit', '#SectionForm', function (e) {
            e.preventDefault();
    
            var form = $(this);
            var submitBtn = form.find('button[type="submit"]');
            var originalBtnText = submitBtn.text();
            var formData = new FormData(this);
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    "RequestVerificationToken": token
                },
                beforeSend: function () {
                    submitBtn.prop('disabled', true).text('Saving...');
                },
                success: function (response) {
                    if(response.success){
                        $('#globalModal').modal('hide');
                        showNotification('Success', response.message, 'success');
                        setTimeout(() => location.reload(), 1500);
                    }
                    else{
                        showNotification('Error', response.message, 'error');
                    }
                },
                error: function (xhr) {
                    showNotification('Error', 'Unable to save data. Please check your inputs.', 'error');
                },
                complete: function () {
                    submitBtn.prop('disabled', false).text(originalBtnText);
                }
            });
        });
               
    </script>
}