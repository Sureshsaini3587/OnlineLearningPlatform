@model CourseSection
 
<form asp-action="@(Model.SectionId == 0 ? "Create" : "Edit")"
      method="post" id="SectionForm" class="needs-validation">
      
    @Html.AntiForgeryToken()

    @if (Model.SectionId != 0)
    {
        <input type="hidden" asp-for="SectionId" />
    }

    <div class="modal-body p-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted small">Section Title <span class="text-danger">*</span></label>
                <input asp-for="SectionTitle" class="form-control" rows="2" placeholder="Enter Section name..." required />
                    <span asp-validation-for="SectionTitle" class="text-danger small"></span>
            </div>           
            <div class="col-md-6 mb-3">
                <label class="form-label fw-bold text-muted small">Sort Order <span class="text-danger">*</span></label>
                <input asp-for="SortOrder" class="form-control" rows="2" placeholder="Enter Section name..." required />
                    <span asp-validation-for="SortOrder" class="text-danger small"></span>
                </div>
        </div> 
        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label fw-bold text-muted small">Course</label>
                <select asp-for="CourseId" asp-items="ViewBag.Course" class="form-control">
                    <option value="">-- Select Course --</option>
                </select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>
        </div> 
            <div class="mt-4 p-3 border rounded bg-light"> 
                <div class="form-check form-switch d-flex justify-content-between align-items-center">
                    <label class="form-check-label fw-bold text-muted small" for="IsActive">Active</label>
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                </div>
            </div>
    </div>

        <div class="modal-footer border-0 p-3 bg-white rounded-bottom">
            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-success px-4 shadow-sm">
            <i class="bi bi-save me-1"></i> @(Model.SectionId == 0 || Model.SectionId == null ? "Save" : "Update Changes")
            </button>
        </div>
    </form>
  
 