@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-left">
                <span class="section-kicker">Welcome back</span>
                <h1>Continue your learning journey</h1>
                <p>Login to access premium videos, dashboard and PQJ practice.</p>
            </div>

            <div class="auth-right">
                <div class="auth-form-card">
                    <h3>Login</h3>
                    <p>Enter your credentials to access your account.</p>

                    <form asp-action="Login" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken() 
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control auth-input" placeholder="Enter your username" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control auth-input" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="btn btn-plan w-100">Login Now</button>
                    </form>

                    <div class="auth-bottom-text">
                        Don’t have an account? <a asp-controller="Account" asp-action="Register">Create one</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

