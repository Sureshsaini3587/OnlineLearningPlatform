@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}
<style>
    .forgot-password-link {
        color: #4f46e5; 
        transition: color 0.2s ease-in-out;
    }

        .forgot-password-link:hover {
            color: #3730a3; 
            text-decoration: underline !important;
        }
</style>
<section class="auth-section">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-left">
                <span class="section-kicker">Welcome back</span>
                <h1>Continue your learning journey</h1>
                <p>Login to access premium videos, dashboard and PQJ practice.</p>
            </div>

            <div class="auth-right">
                <div class="auth-form-card">
                    <h3>Login</h3>
                    <p>Enter your credentials to access your account.</p>

                    <form asp-action="Login" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()  
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /> 
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control auth-input" required placeholder="Enter your username" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control auth-input" required placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check mb-0">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label"></label>
                            </div> 
                            <a asp-controller="Account" asp-action="ForgotPassword" class="forgot-password-link text-decoration-none small fw-medium">
                                Forgot Password?
                            </a>
                        </div>

                        <button type="submit" class="btn btn-plan w-100">Login Now</button>
                    </form>

                    <div class="auth-bottom-text">
                        Don’t have an account? <a asp-controller="Account" asp-action="Register">Create one</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

