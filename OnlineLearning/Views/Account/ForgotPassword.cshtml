@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}
@model ForgotPasswordViewModel

<section class="auth-section">
    <div class="container">
        <div class="auth-shell">
            <!-- Left Branding Side -->
            <div class="auth-left">
                <span class="section-kicker">Security Center</span>
                <h1>Trouble logging in?</h1>
                <p>Enter your registered email address and we will send you a secure recovery link to reset your credentials.</p>
            </div>

            <!-- Right Form Side -->
            <div class="auth-right">
                <div class="auth-form-card">
                    <h3>Reset Password</h3>
                    <p>Recover your account learning portal access.</p>
                     
                     <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                         @Html.AntiForgeryToken()
                         <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                         
                         <div class="mb-4">
                             <label asp-for="Email" class="form-label"></label>
                             <input asp-for="Email" class="form-control auth-input" placeholder="Enter your registered email" />
                             <span asp-validation-for="Email" class="text-danger small"></span>
                         </div>

                         <button type="submit" class="btn btn-plan w-100 mb-3">Send Reset Link</button>
                     </form> 
                     
                    <div class="auth-bottom-text">
                        Remembered your password? <a asp-controller="Account" asp-action="Login">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

 