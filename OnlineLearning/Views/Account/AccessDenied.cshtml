@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}
<div class="container d-flex justify-content-center align-items-center" style="height: 80vh;">

    <div class="card-custom text-center p-5" style="max-width: 500px;">

        <!-- Icon -->
        <div class="mb-4">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 60px;"></i>
        </div>

        <!-- Title -->
        <h2 class="text-danger">Access Denied</h2>

        <!-- Message -->
        <p class="text-muted">
            You don’t have permission to access this page.<br />
            Please contact admin or upgrade your plan.
        </p>

        <!-- Buttons -->
        <div class="mt-4">

            <a asp-controller="WebHome" asp-action="Index"
                   class="btn btn-primary-custom me-2">
                Go to Dashboard
            </a>  
        </div>

    </div>

</div>