@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/Web/_Layout.cshtml";
}

<section class="auth-section">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-left">
                <span class="section-kicker">Account Security</span>
                <h1>Setup your new password</h1>
                <p>Ensure your new password contains letters, numbers, and is at least 6 characters long for optimal security.</p>
            </div>

            <div class="auth-right">
                <div class="auth-form-card">
                    <h3>New Password</h3>
                    <p>Please enter and confirm your new password below.</p>

                    <form asp-action="ResetPassword" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                         
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">New Password</label>
                            <input asp-for="NewPassword" class="form-control auth-input" placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control auth-input" placeholder="Repeat new password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-plan w-100">Update Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
 