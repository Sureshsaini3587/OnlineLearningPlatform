@model PQJPlayerVM

<div class="student-panel-card">
    <div class="pqj-question-top">
        <span>Question @Model?.CurrentIndex of @Model?.TotalQuestions</span>
        @* <strong>Time Left: <span id="timer">@Model?.TimeLeft</span></strong> *@
    </div>

    @if (Model?.Question?.Question != null)
    {
        var q = Model.Question.Question;

        <div class="pqj-question-card">

            <h3>@q.QuestionText</h3>

            <div class="pqj-options">
                @if (q.Options != null && q.Options.Any())
                {
                    foreach (var opt in q.Options)
                    {
                        <label class="pqj-option"> 
                            <input type="radio" data-question="@q.QuestionId" data-attempt="@Model.AttemptId"
                                   name="q_@q.QuestionId" value="@opt.OptionId"   />
                            <span>@opt.OptionText</span>
                        </label>
                    }
                }
                else
                {
                    <p>No options available</p>
                }
            </div>

            <div class="pqj-nav-actions">
                <button class="btn btn-outline-dark rounded-pill px-4 py-3"
                        onclick="loadQuestion(@(Model.CurrentIndex - 1))"
                    @(Model.CurrentIndex == 1 ? "disabled" : "")>
                    Previous
                </button>

                <button class="btn btn-plan"
                        onclick="loadQuestion(@(Model.CurrentIndex + 1))">
                    Next Question
                </button>
            </div>
        </div> 
    }
    else
    {
        <p>No question loaded.</p>
    }
</div>